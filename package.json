{
  "name": "corosync-quorum-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "voice:durability": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py durability",
    "render:durability": "remotion render src/remotion.tsx DurabilityPilot out/write-durability-30s-v1.mp4 --codec=h264 --concurrency=2",
    "voice:pmxcfs-lesson": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py pmxcfs-lesson",
    "render:pmxcfs-lesson": "remotion render src/remotion.tsx PmxcfsLesson out/pmxcfs-7min-v1.mp4 --codec=h264 --concurrency=4",
    "voice:pmxcfs": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py pmxcfs",
    "render:pmxcfs": "remotion render src/remotion.tsx PmxcfsPilot out/pmxcfs-30s-v1.mp4 --codec=h264 --concurrency=2",
    "voice:migration-lesson": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py migration-lesson",
    "render:migration-lesson": "remotion render src/remotion.tsx MigrationLesson out/live-migration-7min-v1.mp4 --codec=h264 --concurrency=4",
    "voice:migration": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py migration",
    "render:migration": "remotion render src/remotion.tsx MigrationPilot out/live-migration-30s-v1.mp4 --codec=h264 --concurrency=2",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "voice": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/narration.ps1",
    "studio": "remotion studio src/remotion.tsx",
    "render": "remotion render src/remotion.tsx QuorumPilot out/quorum-pilot.mp4 --codec=h264 --concurrency=2",
    "still": "remotion still src/remotion.tsx QuorumPilot out/quorum-pilot.png --frame=1740",
    "voice:dark": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py",
    "render:dark": "remotion render src/remotion.tsx QuorumDark out/quorum-dark-30s.mp4 --codec=h264 --concurrency=2",
    "voice:editorial": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py editorial",
    "render:editorial": "remotion render src/remotion.tsx QuorumEditorial out/quorum-editorial-10s.mp4 --codec=h264 --concurrency=2",
    "voice:flow": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py flow",
    "render:flow": "remotion render src/remotion.tsx QuorumFlow out/quorum-flow-30s.mp4 --codec=h264 --concurrency=2",
    "voice:lesson": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py lesson",
    "render:lesson": "remotion render src/remotion.tsx QuorumLesson out/quorum-lesson-75s.mp4 --codec=h264 --concurrency=2",
    "voice:ha-lesson": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py ha-lesson",
    "render:ha-lesson": "remotion render src/remotion.tsx HaLesson out/ha-fencing-7min-v1.mp4 --codec=h264 --concurrency=2",
    "voice:ha": "uv run --with edge-tts==7.2.8 python scripts/dark-narration.py ha",
    "render:ha": "remotion render src/remotion.tsx HaPilot out/ha-fencing-30s.mp4 --codec=h264 --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/player": "4.0.523",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.523",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
