[
  {
    "start": 0.4,
    "end": 34.8,
    "duration": 28.464,
    "file": "audio/quorum-backup-lesson/01.mp3",
    "captions": [
      {
        "start": 0.496,
        "text": "备份还在复制，"
      },
      {
        "start": 1.943,
        "text": "文件系统却已经解冻。"
      },
      {
        "start": 3.976,
        "text": "这究竟是风险，"
      },
      {
        "start": 5.423,
        "text": "还是正确的工作顺序？"
      },
      {
        "start": 7.298,
        "text": "看右边的两份数据。"
      },
      {
        "start": 9.104,
        "text": "运行盘已经写入新值，"
      },
      {
        "start": 10.944,
        "text": "备份仍然保留旧值。"
      },
      {
        "start": 12.912,
        "text": "它们对应不同时间点，"
      },
      {
        "start": 14.625,
        "text": "并不要求始终相同。"
      },
      {
        "start": 16.662,
        "text": "本集追踪一次虚拟机备份。"
      },
      {
        "start": 18.884,
        "text": "分别观察文件系统状态，"
      },
      {
        "start": 20.886,
        "text": "备份保护和复制进度，"
      },
      {
        "start": 22.645,
        "text": "以及应用自身的协调。"
      },
      {
        "start": 24.636,
        "text": "最后再问，"
      },
      {
        "start": 25.701,
        "text": "这些证据能否证明恢复成功。"
      }
    ]
  },
  {
    "start": 35.4,
    "end": 79.8,
    "duration": 40.416,
    "file": "audio/quorum-backup-lesson/02.mp3",
    "captions": [
      {
        "start": 35.496,
        "text": "先把角色放回原来的位置。"
      },
      {
        "start": 38.085,
        "text": "左边是宿主的备份编排。"
      },
      {
        "start": 40.539,
        "text": "它选择磁盘和归档目标，"
      },
      {
        "start": 42.622,
        "text": "并向相关组件发送命令。"
      },
      {
        "start": 44.833,
        "text": "中间是来宾内部。"
      },
      {
        "start": 46.708,
        "text": "来宾代理接收冻结请求，"
      },
      {
        "start": 48.803,
        "text": "调用本地文件系统机制。"
      },
      {
        "start": 50.979,
        "text": "应用有自己的缓冲和事务，"
      },
      {
        "start": 53.166,
        "text": "并不是代理里的一个开关。"
      },
      {
        "start": 55.041,
        "text": "右边是模拟器的块层。"
      },
      {
        "start": 57.217,
        "text": "备份任务从虚拟磁盘取数据，"
      },
      {
        "start": 59.752,
        "text": "写入归档目标。"
      },
      {
        "start": 61.453,
        "text": "冻结命令沿控制路径传递，"
      },
      {
        "start": 63.895,
        "text": "旧数据走另一条复制路径。"
      },
      {
        "start": 66.199,
        "text": "本例选择正常的单磁盘备份，"
      },
      {
        "start": 68.594,
        "text": "不引入缓存分流或远程去重。"
      },
      {
        "start": 71.453,
        "text": "这些方框表示职责，"
      },
      {
        "start": 73.166,
        "text": "不表示额外的持久化副本。"
      }
    ]
  },
  {
    "start": 80.4,
    "end": 129.8,
    "duration": 40.8,
    "file": "audio/quorum-backup-lesson/03.mp3",
    "captions": [
      {
        "start": 80.496,
        "text": "现在从准备状态开始。"
      },
      {
        "start": 82.541,
        "text": "先检查代理和冻结选项。"
      },
      {
        "start": 85.192,
        "text": "代理可用，"
      },
      {
        "start": 86.303,
        "text": "也不等于文件系统已经冻结。"
      },
      {
        "start": 88.814,
        "text": "编排发出冻结请求。"
      },
      {
        "start": 91.013,
        "text": "代理开始同步并冻结。"
      },
      {
        "start": 93.143,
        "text": "成功后，本例文件系统被冻结。"
      },
      {
        "start": 96.268,
        "text": "来宾处理器并没有停机，"
      },
      {
        "start": 98.108,
        "text": "但相关文件系统写入会受限。"
      },
      {
        "start": 100.713,
        "text": "冻结响应回到编排端。"
      },
      {
        "start": 103.12,
        "text": "只有收到成功结果，"
      },
      {
        "start": 104.787,
        "text": "才能把这一观察记为成功。"
      },
      {
        "start": 106.951,
        "text": "命令返回的数量也很重要，"
      },
      {
        "start": 109.023,
        "text": "没有冻结任何文件系统，"
      },
      {
        "start": 110.805,
        "text": "不能画成所有数据都受保护。"
      },
      {
        "start": 113.386,
        "text": "还有网络文件系统，"
      },
      {
        "start": 114.972,
        "text": "它不属于这里的冻结承诺。"
      },
      {
        "start": 117.263,
        "text": "应用事务是否完成，"
      },
      {
        "start": 119.057,
        "text": "仍需要应用自己的证据。"
      }
    ]
  },
  {
    "start": 130.4,
    "end": 184.8,
    "duration": 46.296,
    "file": "audio/quorum-backup-lesson/04.mp3",
    "captions": [
      {
        "start": 130.496,
        "text": "文件系统现在保持冻结。"
      },
      {
        "start": 133.016,
        "text": "编排请求启动备份。"
      },
      {
        "start": 135.168,
        "text": "块层建立写前复制保护。"
      },
      {
        "start": 137.507,
        "text": "然后启动后台备份任务。"
      },
      {
        "start": 139.763,
        "text": "启动响应返回宿主。"
      },
      {
        "start": 142.125,
        "text": "这时得到的是任务标识，"
      },
      {
        "start": 143.988,
        "text": "不是一份已经完成的归档。"
      },
      {
        "start": 145.99,
        "text": "编排随后请求解冻。"
      },
      {
        "start": 148.074,
        "text": "文件系统恢复写入。"
      },
      {
        "start": 150.145,
        "text": "解冻响应回到编排。"
      },
      {
        "start": 152.171,
        "text": "后台先复制示意块乙。"
      },
      {
        "start": 154.3,
        "text": "这解释了为什么可以提前解冻。"
      },
      {
        "start": 156.893,
        "text": "后续写入经过保护机制，"
      },
      {
        "start": 159.115,
        "text": "不会直接毁掉仍需备份的旧块。"
      },
      {
        "start": 161.997,
        "text": "冻结窗口围住的是保护建立，"
      },
      {
        "start": 164.277,
        "text": "不是整块磁盘的复制时长。"
      },
      {
        "start": 166.731,
        "text": "这里叫快照备份模式，"
      },
      {
        "start": 168.467,
        "text": "也不要求底层存储，"
      },
      {
        "start": 169.995,
        "text": "先创建一个同名的存储快照。"
      },
      {
        "start": 172.356,
        "text": "时间轴是教学安排，"
      },
      {
        "start": 174.127,
        "text": "不是生产环境的耗时测量。"
      }
    ]
  },
  {
    "start": 185.4,
    "end": 249.8,
    "duration": 59.832,
    "file": "audio/quorum-backup-lesson/05.mp3",
    "captions": [
      {
        "start": 185.496,
        "text": "现在让新写入撞上后台复制。"
      },
      {
        "start": 188.525,
        "text": "块甲尚未进入备份。"
      },
      {
        "start": 190.493,
        "text": "来宾提交甲的新值。"
      },
      {
        "start": 192.472,
        "text": "写前复制先拦住这次覆盖。"
      },
      {
        "start": 195.122,
        "text": "块层读取甲的旧内容。"
      },
      {
        "start": 197.043,
        "text": "旧内容进入备份复制路径。"
      },
      {
        "start": 199.856,
        "text": "目标成功接收这份旧内容。"
      },
      {
        "start": 202.206,
        "text": "现在才允许覆盖运行盘。"
      },
      {
        "start": 204.787,
        "text": "运行盘里的甲变成新值，"
      },
      {
        "start": 207.043,
        "text": "归档里留下原时间点的旧值。"
      },
      {
        "start": 209.844,
        "text": "这不是把每次新写都存两份。"
      },
      {
        "start": 212.645,
        "text": "再看已经备份的块乙。"
      },
      {
        "start": 214.601,
        "text": "来宾提交乙的新值。"
      },
      {
        "start": 216.569,
        "text": "乙的旧内容已经得到保护，"
      },
      {
        "start": 218.699,
        "text": "无需为这次覆盖再复制一遍。"
      },
      {
        "start": 221.199,
        "text": "随后乙在运行盘上改变。"
      },
      {
        "start": 223.722,
        "text": "归档中的乙仍保持旧值。"
      },
      {
        "start": 226.164,
        "text": "内部复制状态用于协调，"
      },
      {
        "start": 228.421,
        "text": "后台复制与写入触发的复制。"
      },
      {
        "start": 231.233,
        "text": "如果目标很慢，"
      },
      {
        "start": 232.622,
        "text": "未保护旧块的写入可能等待。"
      },
      {
        "start": 235.273,
        "text": "本例没有启用缓存分流，"
      },
      {
        "start": 237.287,
        "text": "所以不把额外缓存画进路径。"
      },
      {
        "start": 239.798,
        "text": "两个块完成也不等于整份完成，"
      },
      {
        "start": 242.541,
        "text": "还有其他块需要继续复制。"
      }
    ]
  },
  {
    "start": 250.4,
    "end": 304.8,
    "duration": 52.704,
    "file": "audio/quorum-backup-lesson/06.mp3",
    "captions": [
      {
        "start": 250.496,
        "text": "下面单独看应用协调。"
      },
      {
        "start": 252.888,
        "text": "文件系统看见的是文件和写入，"
      },
      {
        "start": 255.516,
        "text": "不理解应用的全部业务约束。"
      },
      {
        "start": 257.865,
        "text": "我们选数据库作为具体对照。"
      },
      {
        "start": 260.493,
        "text": "这里使用干净停库的保守方案。"
      },
      {
        "start": 263.178,
        "text": "先正常停止数据库。"
      },
      {
        "start": 265.331,
        "text": "确认数据库已经干净退出。"
      },
      {
        "start": 267.981,
        "text": "把完整数据目录，"
      },
      {
        "start": 269.474,
        "text": "事务状态和日志一起纳入范围。"
      },
      {
        "start": 272.541,
        "text": "本例都位于同一个被备份磁盘。"
      },
      {
        "start": 275.192,
        "text": "随后冻结并建立备份保护。"
      },
      {
        "start": 277.668,
        "text": "解冻之后，其他服务可以写入。"
      },
      {
        "start": 280.377,
        "text": "本对照让数据库保持停止，"
      },
      {
        "start": 282.634,
        "text": "直到备份流程成功结束。"
      },
      {
        "start": 284.96,
        "text": "之后再启动数据库。"
      },
      {
        "start": 286.905,
        "text": "这会牺牲可用性，"
      },
      {
        "start": 288.409,
        "text": "不是通用的在线协调脚本。"
      },
      {
        "start": 290.724,
        "text": "完整一致快照也可能支持，"
      },
      {
        "start": 293.166,
        "text": "数据库启动时通过日志恢复。"
      },
      {
        "start": 296.013,
        "text": "所以没有专用协调，"
      },
      {
        "start": 297.935,
        "text": "并不等于数据库必然损坏。"
      },
      {
        "start": 300.296,
        "text": "本集没有实际执行恢复验证。"
      }
    ]
  },
  {
    "start": 305.4,
    "end": 364.8,
    "duration": 52.752,
    "file": "audio/quorum-backup-lesson/07.mp3",
    "captions": [
      {
        "start": 305.496,
        "text": "再区分故障与完成的证据。"
      },
      {
        "start": 307.854,
        "text": "先看独立的冻结失败对照。"
      },
      {
        "start": 310.469,
        "text": "冻结调用返回错误。"
      },
      {
        "start": 312.53,
        "text": "编排会记录这个错误，"
      },
      {
        "start": 314.347,
        "text": "仍保留后续解冻的清理标记。"
      },
      {
        "start": 317.009,
        "text": "这个标记不是冻结成功证明。"
      },
      {
        "start": 319.787,
        "text": "调用解冻也不保证已经解冻，"
      },
      {
        "start": 322.182,
        "text": "必须继续核对结果和状态。"
      },
      {
        "start": 324.717,
        "text": "不要把错误日志旁的内部变量，"
      },
      {
        "start": 326.847,
        "text": "直接翻译成绿色成功画面。"
      },
      {
        "start": 329.254,
        "text": "现在回到归档的完成判定。"
      },
      {
        "start": 331.962,
        "text": "第一步只是任务已经启动。"
      },
      {
        "start": 334.266,
        "text": "第二步要等复制结果，"
      },
      {
        "start": 335.909,
        "text": "并检查任务报告的错误。"
      },
      {
        "start": 337.865,
        "text": "归档输出链也要正确结束，"
      },
      {
        "start": 340.192,
        "text": "不能只看进度接近百分之百。"
      },
      {
        "start": 342.553,
        "text": "随后检查产物是否可读。"
      },
      {
        "start": 345.099,
        "text": "再在隔离环境恢复并启动。"
      },
      {
        "start": 347.576,
        "text": "最后检查业务数据与功能。"
      },
      {
        "start": 350.087,
        "text": "这些是需要补齐的验收证据，"
      },
      {
        "start": 352.032,
        "text": "不是本片已经执行的实验。"
      },
      {
        "start": 354.208,
        "text": "备份命令成功，"
      },
      {
        "start": 355.55,
        "text": "不自动证明业务恢复成功。"
      }
    ]
  },
  {
    "start": 365.4,
    "end": 419.8,
    "duration": 49.656,
    "file": "audio/quorum-backup-lesson/08.mp3",
    "captions": [
      {
        "start": 365.496,
        "text": "最后用三个问题检查理解。"
      },
      {
        "start": 368.027,
        "text": "解冻意味着整份备份完成吗？"
      },
      {
        "start": 370.655,
        "text": "不意味着，保护建立后仍要复制。"
      },
      {
        "start": 373.907,
        "text": "文件系统冻结证明事务完成吗？"
      },
      {
        "start": 376.731,
        "text": "不能，应用协调需要独立证据。"
      },
      {
        "start": 379.682,
        "text": "归档任务成功就能放心恢复吗？"
      },
      {
        "start": 382.553,
        "text": "还需要实际恢复和业务检查。"
      },
      {
        "start": 385.388,
        "text": "现在回放一次正常路径。"
      },
      {
        "start": 387.495,
        "text": "代理冻结本地文件系统。"
      },
      {
        "start": 389.717,
        "text": "块层保护建立，任务启动。"
      },
      {
        "start": 392.506,
        "text": "收到启动响应后解冻。"
      },
      {
        "start": 394.59,
        "text": "后台复制已经继续运行。"
      },
      {
        "start": 397.113,
        "text": "未备份的旧块遇到覆盖写。"
      },
      {
        "start": 399.787,
        "text": "先复制旧内容，再写入新值。"
      },
      {
        "start": 402.703,
        "text": "运行盘向前走，备份保留过去。"
      },
      {
        "start": 405.736,
        "text": "判断一个备份方案，"
      },
      {
        "start": 407.171,
        "text": "要同时追问时间点，"
      },
      {
        "start": 408.976,
        "text": "覆盖范围和恢复证据。"
      },
      {
        "start": 411.245,
        "text": "这样才能把一份文件，"
      },
      {
        "start": 412.692,
        "text": "变成有依据的恢复能力。"
      }
    ]
  }
]
