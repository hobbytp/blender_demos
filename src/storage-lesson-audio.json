[
  {
    "start": 0,
    "end": 35,
    "duration": 31.032,
    "file": "audio/quorum-storage-lesson/01.mp3",
    "captions": [
      {
        "start": 0.096,
        "text": "上一集里，"
      },
      {
        "start": 1.219,
        "text": "启动任务需要先激活存储卷。"
      },
      {
        "start": 4.375,
        "text": "这一步究竟做了什么？"
      },
      {
        "start": 6.47,
        "text": "先把四个名字分开。"
      },
      {
        "start": 8.426,
        "text": "存储编号，定位一份配置。"
      },
      {
        "start": 10.891,
        "text": "存储类型，决定使用哪种插件。"
      },
      {
        "start": 13.727,
        "text": "卷名，定位后端中的一个对象。"
      },
      {
        "start": 16.505,
        "text": "镜像格式，描述数据的组织方式。"
      },
      {
        "start": 19.618,
        "text": "它们不能互相代替。"
      },
      {
        "start": 21.412,
        "text": "本集沿用已有磁盘的正常启动，"
      },
      {
        "start": 23.831,
        "text": "再比较几种后端和失败阶段。"
      },
      {
        "start": 26.528,
        "text": "画面展示的是机制，"
      },
      {
        "start": 28.044,
        "text": "没有实际挂载或启动虚拟机。"
      }
    ]
  },
  {
    "start": 35,
    "end": 85,
    "duration": 42.48,
    "file": "audio/quorum-storage-lesson/02.mp3",
    "captions": [
      {
        "start": 35.096,
        "text": "现在跟踪这份磁盘配置。"
      },
      {
        "start": 37.257,
        "text": "冒号前是存储编号，"
      },
      {
        "start": 39.074,
        "text": "后面是该存储里的卷名。"
      },
      {
        "start": 41.447,
        "text": "启动代码解析卷标识，"
      },
      {
        "start": 43.368,
        "text": "再查找对应存储配置。"
      },
      {
        "start": 45.37,
        "text": "配置包含类型、服务端，"
      },
      {
        "start": 47.674,
        "text": "导出目录和本机挂载点。"
      },
      {
        "start": 50.012,
        "text": "但配置存在，"
      },
      {
        "start": 51.377,
        "text": "还不代表本节点允许使用。"
      },
      {
        "start": 53.692,
        "text": "禁用标记可以阻止激活，"
      },
      {
        "start": 55.822,
        "text": "节点列表也可以限制范围。"
      },
      {
        "start": 58.032,
        "text": "正常主线通过这些条件。"
      },
      {
        "start": 60.521,
        "text": "随后按类型找到插件。"
      },
      {
        "start": 62.755,
        "text": "这不是发消息给新服务，"
      },
      {
        "start": 64.583,
        "text": "而是在管理进程里，"
      },
      {
        "start": 66.181,
        "text": "调用相应的插件实现。"
      },
      {
        "start": 68.194,
        "text": "相同的接口之下，"
      },
      {
        "start": 69.676,
        "text": "不同后端执行不同准备工作。"
      },
      {
        "start": 72.442,
        "text": "存储类型不是镜像格式，"
      },
      {
        "start": 74.641,
        "text": "文件名也不能代替配置检查。"
      }
    ]
  },
  {
    "start": 85,
    "end": 140,
    "duration": 44.448,
    "file": "audio/quorum-storage-lesson/03.mp3",
    "captions": [
      {
        "start": 85.096,
        "text": "接着展开网络文件存储。"
      },
      {
        "start": 87.384,
        "text": "先检查服务端是否可联系。"
      },
      {
        "start": 90.069,
        "text": "在线检查通过，"
      },
      {
        "start": 91.435,
        "text": "不等于镜像一定可读。"
      },
      {
        "start": 93.356,
        "text": "插件再读取本机挂载状态。"
      },
      {
        "start": 95.903,
        "text": "本例开始时还没有挂载，"
      },
      {
        "start": 98.009,
        "text": "因此请求宿主建立挂载。"
      },
      {
        "start": 100.289,
        "text": "内核联系远端导出目录，"
      },
      {
        "start": 102.303,
        "text": "正常返回后，挂载可用。"
      },
      {
        "start": 104.572,
        "text": "如果原本已经挂载，"
      },
      {
        "start": 106.111,
        "text": "这里可以复用现有挂载。"
      },
      {
        "start": 108.032,
        "text": "不是每次启动都重新挂载。"
      },
      {
        "start": 110.625,
        "text": "随后检查镜像文件存在。"
      },
      {
        "start": 112.928,
        "text": "这一部分由插件基类实现。"
      },
      {
        "start": 115.486,
        "text": "已有文件通过检查，"
      },
      {
        "start": 117.234,
        "text": "不需要复制整个虚拟磁盘。"
      },
      {
        "start": 119.456,
        "text": "同一个存储的多个卷，"
      },
      {
        "start": 121.053,
        "text": "先按存储编号汇总激活，"
      },
      {
        "start": 123.148,
        "text": "再逐个进行卷级准备。"
      },
      {
        "start": 125.185,
        "text": "这些检查各有范围，"
      },
      {
        "start": 126.898,
        "text": "都不能提前代表业务可用。"
      }
    ]
  },
  {
    "start": 140,
    "end": 195,
    "duration": 46.728,
    "file": "audio/quorum-storage-lesson/04.mp3",
    "captions": [
      {
        "start": 140.096,
        "text": "现在解析这块卷的本机路径。"
      },
      {
        "start": 142.558,
        "text": "从配置里的挂载点开始，"
      },
      {
        "start": 144.56,
        "text": "加上默认镜像目录，"
      },
      {
        "start": 146.215,
        "text": "再加虚拟机号和文件名。"
      },
      {
        "start": 148.657,
        "text": "本例没有快照或自定义目录。"
      },
      {
        "start": 151.366,
        "text": "生成启动参数时，"
      },
      {
        "start": 153.113,
        "text": "路径和格式交给虚拟机进程。"
      },
      {
        "start": 156.088,
        "text": "进程随后打开镜像文件。"
      },
      {
        "start": 158.518,
        "text": "这仍然是启动准备。"
      },
      {
        "start": 160.451,
        "text": "下面单独发出一次读取。"
      },
      {
        "start": 162.627,
        "text": "请求先进入宿主文件系统。"
      },
      {
        "start": 165.197,
        "text": "本例需要访问服务端，"
      },
      {
        "start": 166.794,
        "text": "所以继续经过存储网络。"
      },
      {
        "start": 169.051,
        "text": "服务端处理这次读取，"
      },
      {
        "start": 170.764,
        "text": "数据再返回宿主，"
      },
      {
        "start": 172.315,
        "text": "最后回到虚拟机进程。"
      },
      {
        "start": 174.363,
        "text": "插件没有转发这批磁盘数据。"
      },
      {
        "start": 176.887,
        "text": "如果缓存已经满足读取，"
      },
      {
        "start": 178.843,
        "text": "实际路径可能不必访问网络。"
      },
      {
        "start": 181.528,
        "text": "这里的完成只覆盖这次读，"
      },
      {
        "start": 183.704,
        "text": "不是写入持久化或业务验收。"
      }
    ]
  },
  {
    "start": 195,
    "end": 250,
    "duration": 40.848,
    "file": "audio/quorum-storage-lesson/05.mp3",
    "captions": [
      {
        "start": 195.096,
        "text": "换一种后端，路径还一样吗？"
      },
      {
        "start": 197.72,
        "text": "先保留文件型存储。"
      },
      {
        "start": 199.78,
        "text": "这里返回的是文件路径，"
      },
      {
        "start": 201.609,
        "text": "网络文件存储通过本机挂载访问。"
      },
      {
        "start": 204.664,
        "text": "再看本地精简逻辑卷。"
      },
      {
        "start": 206.829,
        "text": "插件激活对应逻辑卷，"
      },
      {
        "start": 208.785,
        "text": "返回的是块设备路径。"
      },
      {
        "start": 210.706,
        "text": "它不是镜像目录中的文件。"
      },
      {
        "start": 212.778,
        "text": "同样叫激活卷，"
      },
      {
        "start": 214.051,
        "text": "实际操作已经不同。"
      },
      {
        "start": 216.018,
        "text": "再看分布式块存储。"
      },
      {
        "start": 217.893,
        "text": "未启用内核映射时，"
      },
      {
        "start": 219.56,
        "text": "后端可以提供协议描述，"
      },
      {
        "start": 221.458,
        "text": "虚拟机使用相应客户端访问。"
      },
      {
        "start": 223.958,
        "text": "启用内核映射则是另一分支，"
      },
      {
        "start": 226.192,
        "text": "先映射为本机块设备，"
      },
      {
        "start": 227.847,
        "text": "再通过内核访问后端。"
      },
      {
        "start": 229.85,
        "text": "这几幅图是独立对照，"
      },
      {
        "start": 231.713,
        "text": "不把一种后端的路径，"
      },
      {
        "start": 233.056,
        "text": "推广成所有存储的统一路径。"
      }
    ]
  },
  {
    "start": 250,
    "end": 310,
    "duration": 51.864,
    "file": "audio/quorum-storage-lesson/06.mp3",
    "captions": [
      {
        "start": 250.096,
        "text": "再看最容易混淆的共享。"
      },
      {
        "start": 252.384,
        "text": "集群会分发存储配置。"
      },
      {
        "start": 254.664,
        "text": "节点甲和节点乙，"
      },
      {
        "start": 256.169,
        "text": "可以看到相同的存储编号，"
      },
      {
        "start": 258.148,
        "text": "以及相同的本机目录。"
      },
      {
        "start": 260.174,
        "text": "先看本地目录的对照。"
      },
      {
        "start": 262.269,
        "text": "甲的数据仍在甲的磁盘，"
      },
      {
        "start": 264.722,
        "text": "乙的数据仍在乙的磁盘。"
      },
      {
        "start": 267.095,
        "text": "同名配置没有复制这些文件。"
      },
      {
        "start": 269.792,
        "text": "把它标为共享也不会搬运数据。"
      },
      {
        "start": 272.535,
        "text": "现在切换到真正的共享后端。"
      },
      {
        "start": 275.278,
        "text": "两侧都获准访问同一导出，"
      },
      {
        "start": 277.87,
        "text": "并且分别完成本机挂载。"
      },
      {
        "start": 280.058,
        "text": "甲的访问到达这个后端，"
      },
      {
        "start": 282.188,
        "text": "乙的访问也到达同一个后端。"
      },
      {
        "start": 284.664,
        "text": "共享来自后端和访问条件，"
      },
      {
        "start": 286.829,
        "text": "不是来自配置文件长得一样。"
      },
      {
        "start": 288.854,
        "text": "两侧本机准备仍各自进行。"
      },
      {
        "start": 291.725,
        "text": "即使数据共享已经成立，"
      },
      {
        "start": 293.785,
        "text": "也不能随意同时启动同一虚拟机。"
      },
      {
        "start": 296.91,
        "text": "运行协调和防止重复写入，"
      },
      {
        "start": 299.468,
        "text": "还需要另外的机制保证。"
      }
    ]
  },
  {
    "start": 310,
    "end": 365,
    "duration": 44.952,
    "file": "audio/quorum-storage-lesson/07.mp3",
    "captions": [
      {
        "start": 310.096,
        "text": "最后比较三个独立失败案例。"
      },
      {
        "start": 312.384,
        "text": "每例都从尚未启动开始。"
      },
      {
        "start": 314.907,
        "text": "第一例，存储配置被禁用。"
      },
      {
        "start": 317.558,
        "text": "激活入口检查后拒绝，"
      },
      {
        "start": 319.433,
        "text": "还没有进入后端准备。"
      },
      {
        "start": 321.296,
        "text": "第二例，在线检查已经通过，"
      },
      {
        "start": 323.738,
        "text": "但本机挂载执行失败。"
      },
      {
        "start": 325.775,
        "text": "挂载结果没有成功返回，"
      },
      {
        "start": 327.72,
        "text": "不能点亮挂载可用。"
      },
      {
        "start": 329.479,
        "text": "第三例，挂载已经成功，"
      },
      {
        "start": 331.701,
        "text": "但目标镜像文件不存在。"
      },
      {
        "start": 334.086,
        "text": "卷级检查抛出错误，"
      },
      {
        "start": 335.949,
        "text": "同样不能继续到打开镜像。"
      },
      {
        "start": 338.137,
        "text": "这三个错误发生在不同阶段。"
      },
      {
        "start": 340.926,
        "text": "都不能只用配置存在来排除。"
      },
      {
        "start": 343.264,
        "text": "也不能看到挂载成功，"
      },
      {
        "start": 344.884,
        "text": "就宣布虚拟机磁盘准备完成。"
      },
      {
        "start": 347.569,
        "text": "排查时先确认存储编号，"
      },
      {
        "start": 350.0,
        "text": "再看节点条件和具体错误，"
      },
      {
        "start": 352.396,
        "text": "沿着失败阶段寻找证据。"
      }
    ]
  },
  {
    "start": 365,
    "end": 420,
    "duration": 49.92,
    "file": "audio/quorum-storage-lesson/08.mp3",
    "captions": [
      {
        "start": 365.096,
        "text": "清空失败结果，再走一次主线。"
      },
      {
        "start": 367.894,
        "text": "卷引用定位配置，"
      },
      {
        "start": 369.41,
        "text": "类型选择对应插件。"
      },
      {
        "start": 371.424,
        "text": "确认挂载，检查已有文件。"
      },
      {
        "start": 373.924,
        "text": "解析路径，交给虚拟机打开。"
      },
      {
        "start": 376.655,
        "text": "再发起独立的数据读取，"
      },
      {
        "start": 378.669,
        "text": "请求到达后端，数据返回。"
      },
      {
        "start": 381.366,
        "text": "同一张图保留两条因果链。"
      },
      {
        "start": 384.167,
        "text": "上方解释如何准备资源，"
      },
      {
        "start": 386.505,
        "text": "下方解释数据如何流动。"
      },
      {
        "start": 389.178,
        "text": "要判断快照和克隆能力，"
      },
      {
        "start": 391.331,
        "text": "还要回到具体插件。"
      },
      {
        "start": 393.137,
        "text": "能力检查带上卷和操作状态，"
      },
      {
        "start": 395.81,
        "text": "文件型后端还会涉及镜像格式。"
      },
      {
        "start": 398.773,
        "text": "配置和版本也需要一起核对。"
      },
      {
        "start": 401.25,
        "text": "因此，看到网络存储这几个字，"
      },
      {
        "start": 403.935,
        "text": "不能直接断言全部能力。"
      },
      {
        "start": 406.134,
        "text": "先分清存储编号、类型和卷，"
      },
      {
        "start": 408.9,
        "text": "再核对准备过程和数据路径，"
      },
      {
        "start": 411.215,
        "text": "才知道成功或失败发生在哪层。"
      }
    ]
  }
]
