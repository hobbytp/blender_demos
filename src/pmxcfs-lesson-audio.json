[
  {
    "start": 0.5,
    "end": 29.5,
    "duration": 25.128,
    "file": "audio/quorum-pmxcfs-lesson/01.mp3",
    "captions": [
      {
        "start": 0.596,
        "text": "上一集，热迁移改变了配置归属。"
      },
      {
        "start": 3.914,
        "text": "现在追问一个基础问题："
      },
      {
        "start": 5.836,
        "text": "为什么不同节点，"
      },
      {
        "start": 7.062,
        "text": "都能看到集群中的配置？"
      },
      {
        "start": 9.03,
        "text": "看上方这个完整路径。"
      },
      {
        "start": 11.056,
        "text": "它属于节点乙，"
      },
      {
        "start": 12.433,
        "text": "但我们从节点甲访问它。"
      },
      {
        "start": 14.458,
        "text": "比较前先固定同一个对象，"
      },
      {
        "start": 16.634,
        "text": "不能把各节点的本地别名，"
      },
      {
        "start": 18.498,
        "text": "直接当成同一个文件。"
      },
      {
        "start": 20.512,
        "text": "这一集只追踪一次配置写入，"
      },
      {
        "start": 22.688,
        "text": "虚拟磁盘不走这条复制路径。"
      }
    ]
  },
  {
    "start": 30.5,
    "end": 64.5,
    "duration": 31.872,
    "file": "audio/quorum-pmxcfs-lesson/02.mp3",
    "captions": [
      {
        "start": 30.596,
        "text": "先展开节点内部。"
      },
      {
        "start": 32.583,
        "text": "最上面是本机文件系统入口。"
      },
      {
        "start": 35.28,
        "text": "文件操作通过用户态文件系统，"
      },
      {
        "start": 38.046,
        "text": "进入配置文件系统进程。"
      },
      {
        "start": 40.338,
        "text": "进程里有内存配置树，"
      },
      {
        "start": 42.317,
        "text": "也有访问本地数据库的代码。"
      },
      {
        "start": 44.551,
        "text": "数据库文件保存在本机。"
      },
      {
        "start": 47.028,
        "text": "下方单独画出集群通信进程。"
      },
      {
        "start": 49.956,
        "text": "它负责节点之间的组通信。"
      },
      {
        "start": 52.144,
        "text": "这不是一个远程数据库服务器。"
      },
      {
        "start": 54.632,
        "text": "三个节点各自维护配置副本，"
      },
      {
        "start": 56.935,
        "text": "也各自提供本机访问入口。"
      },
      {
        "start": 59.238,
        "text": "留意进程边界和消息通道。"
      }
    ]
  },
  {
    "start": 65.5,
    "end": 104.5,
    "duration": 37.92,
    "file": "audio/quorum-pmxcfs-lesson/03.mp3",
    "captions": [
      {
        "start": 65.596,
        "text": "现在，一次写操作进入甲。"
      },
      {
        "start": 68.359,
        "text": "假设权限已经允许，"
      },
      {
        "start": 70.072,
        "text": "三个节点也已经同步。"
      },
      {
        "start": 71.981,
        "text": "发送前先检查本机仲裁状态。"
      },
      {
        "start": 74.771,
        "text": "有仲裁，才允许进入发送路径。"
      },
      {
        "start": 77.861,
        "text": "允许写入不等于已经改好。"
      },
      {
        "start": 80.431,
        "text": "看内存，它此时仍是旧值。"
      },
      {
        "start": 83.324,
        "text": "接着把操作交给分布式状态机。"
      },
      {
        "start": 86.125,
        "text": "消息带着路径、内容和偏移，"
      },
      {
        "start": 88.683,
        "text": "进入集群组通信。"
      },
      {
        "start": 90.396,
        "text": "调用者暂时等待处理结果。"
      },
      {
        "start": 92.78,
        "text": "整次界面保存可能还包含，"
      },
      {
        "start": 95.118,
        "text": "临时文件、重命名和上层锁。"
      },
      {
        "start": 98.278,
        "text": "我们跟踪的是其中一次写操作，"
      },
      {
        "start": 100.928,
        "text": "不能把它当成完整业务事务。"
      }
    ]
  },
  {
    "start": 105.5,
    "end": 144.5,
    "duration": 36.36,
    "file": "audio/quorum-pmxcfs-lesson/04.mp3",
    "captions": [
      {
        "start": 105.596,
        "text": "看操作怎样返回各节点。"
      },
      {
        "start": 108.023,
        "text": "组通信提供一致的交付顺序。"
      },
      {
        "start": 110.986,
        "text": "发送节点自己也接收这条操作。"
      },
      {
        "start": 113.891,
        "text": "它不是先任意改好本机，"
      },
      {
        "start": 115.812,
        "text": "再把数据库文件复制给别人。"
      },
      {
        "start": 118.394,
        "text": "为了看清顺序，"
      },
      {
        "start": 119.782,
        "text": "旁边另举两条操作的队列例子。"
      },
      {
        "start": 122.34,
        "text": "先交付第一条，再交付第二条。"
      },
      {
        "start": 125.396,
        "text": "不同节点的处理速度可以不同，"
      },
      {
        "start": 127.502,
        "text": "但交付次序保持一致。"
      },
      {
        "start": 129.725,
        "text": "顺序一致不等于同时完成。"
      },
      {
        "start": 132.491,
        "text": "这里使用约定顺序的消息类型，"
      },
      {
        "start": 134.852,
        "text": "不能把它说成所有磁盘，"
      },
      {
        "start": 136.6,
        "text": "都已经确认持久保存。"
      },
      {
        "start": 138.637,
        "text": "示意延迟不代表真实网络性能。"
      }
    ]
  },
  {
    "start": 145.5,
    "end": 184.5,
    "duration": 35.472,
    "file": "audio/quorum-pmxcfs-lesson/05.mp3",
    "captions": [
      {
        "start": 145.596,
        "text": "回到刚才那一次写入。"
      },
      {
        "start": 147.375,
        "text": "正常同步状态下，"
      },
      {
        "start": 148.891,
        "text": "交付回调解析操作，"
      },
      {
        "start": 150.523,
        "text": "调用本机内存数据库的写函数。"
      },
      {
        "start": 153.59,
        "text": "操作抵达后，内存才变成新值。"
      },
      {
        "start": 156.588,
        "text": "随后记录到本地数据库。"
      },
      {
        "start": 159.007,
        "text": "另外两个节点也各自执行，"
      },
      {
        "start": 161.403,
        "text": "更新各自维护的配置副本。"
      },
      {
        "start": 163.602,
        "text": "本地修改期间持有内部互斥锁。"
      },
      {
        "start": 166.472,
        "text": "看仍在处理的节点丙："
      },
      {
        "start": 168.174,
        "text": "新的读取需要等待这次修改。"
      },
      {
        "start": 170.859,
        "text": "不能把内存和数据库的中间态，"
      },
      {
        "start": 173.37,
        "text": "画成应用任意读取的半成品。"
      },
      {
        "start": 175.882,
        "text": "本例假定没有磁盘错误，"
      },
      {
        "start": 177.988,
        "text": "错误处理和重同步另行展开。"
      }
    ]
  },
  {
    "start": 185.5,
    "end": 224.5,
    "duration": 31.8,
    "file": "audio/quorum-pmxcfs-lesson/06.mp3",
    "captions": [
      {
        "start": 185.596,
        "text": "写调用究竟等待谁？"
      },
      {
        "start": 187.896,
        "text": "甲等待自己发出的消息，"
      },
      {
        "start": 189.539,
        "text": "在本机被交付并处理，"
      },
      {
        "start": 191.518,
        "text": "然后记录本机处理结果。"
      },
      {
        "start": 193.625,
        "text": "现在，结果沿本机调用链返回。"
      },
      {
        "start": 196.553,
        "text": "看丙，它可以稍晚完成。"
      },
      {
        "start": 198.938,
        "text": "这个等待条件，"
      },
      {
        "start": 200.188,
        "text": "不是逐台收集磁盘回执。"
      },
      {
        "start": 202.479,
        "text": "我们没有画那条虚构的确认线。"
      },
      {
        "start": 204.852,
        "text": "还有一个存储层面的区别："
      },
      {
        "start": 206.819,
        "text": "本地数据库事务提交，"
      },
      {
        "start": 208.463,
        "text": "不能直接等同于每次写入，"
      },
      {
        "start": 210.28,
        "text": "都已经获得断电持久性保证。"
      },
      {
        "start": 212.722,
        "text": "实际日志与同步设置，"
      },
      {
        "start": 214.655,
        "text": "决定怎样理解持久化边界。"
      }
    ]
  },
  {
    "start": 225.5,
    "end": 259.5,
    "duration": 33.072,
    "file": "audio/quorum-pmxcfs-lesson/07.mp3",
    "captions": [
      {
        "start": 225.596,
        "text": "配置稳定后，读取走哪里？"
      },
      {
        "start": 228.185,
        "text": "一个读请求进入甲的文件入口。"
      },
      {
        "start": 231.125,
        "text": "它访问本机内存中的配置。"
      },
      {
        "start": 233.324,
        "text": "结果沿本机路径返回。"
      },
      {
        "start": 235.465,
        "text": "此时网络上没有新的查询。"
      },
      {
        "start": 238.093,
        "text": "不是每读一个文件，"
      },
      {
        "start": 239.516,
        "text": "都向其他节点重新问一遍。"
      },
      {
        "start": 241.715,
        "text": "复制路径让各节点维护副本，"
      },
      {
        "start": 244.366,
        "text": "读取路径使用本地状态。"
      },
      {
        "start": 246.866,
        "text": "如果本地正在修改，"
      },
      {
        "start": 248.463,
        "text": "读取可能需要等待内部锁。"
      },
      {
        "start": 250.697,
        "text": "反过来，能读到配置，"
      },
      {
        "start": 252.838,
        "text": "也不能单独证明集群可以写入。"
      },
      {
        "start": 255.627,
        "text": "这两种能力必须分别判断。"
      }
    ]
  },
  {
    "start": 260.5,
    "end": 299.5,
    "duration": 35.736,
    "file": "audio/quorum-pmxcfs-lesson/08.mp3",
    "captions": [
      {
        "start": 260.596,
        "text": "现在切换到稍后的分区对照。"
      },
      {
        "start": 263.266,
        "text": "分区已经稳定，"
      },
      {
        "start": 264.852,
        "text": "甲和乙组成多数，"
      },
      {
        "start": 266.252,
        "text": "丙只剩自己的一票。"
      },
      {
        "start": 267.954,
        "text": "在丙上发起一次新的写入。"
      },
      {
        "start": 270.234,
        "text": "仲裁检查拒绝它继续前进。"
      },
      {
        "start": 272.861,
        "text": "没有新的写操作进入复制路径。"
      },
      {
        "start": 275.824,
        "text": "之前保存的配置保持不变。"
      },
      {
        "start": 278.44,
        "text": "再从丙发起读取。"
      },
      {
        "start": 280.234,
        "text": "本机仍然返回保存的配置。"
      },
      {
        "start": 282.56,
        "text": "有本地数据库不等于能独立写。"
      },
      {
        "start": 285.361,
        "text": "这里限制的是配置文件系统。"
      },
      {
        "start": 288.0,
        "text": "虚拟机是否继续运行，"
      },
      {
        "start": 290.188,
        "text": "何时能够由其他节点接管，"
      },
      {
        "start": 292.213,
        "text": "还要回到第一集的安全条件，"
      },
      {
        "start": 294.076,
        "text": "不能只看这张票数卡。"
      }
    ]
  },
  {
    "start": 300.5,
    "end": 339.5,
    "duration": 37.464,
    "file": "audio/quorum-pmxcfs-lesson/09.mp3",
    "captions": [
      {
        "start": 300.596,
        "text": "还有一层锁，需要单独理解。"
      },
      {
        "start": 303.231,
        "text": "回到有仲裁的协作示例。"
      },
      {
        "start": 305.512,
        "text": "操作有一致顺序，"
      },
      {
        "start": 306.958,
        "text": "不代表读取、判断、再修改，"
      },
      {
        "start": 309.863,
        "text": "自动组成不可分割的事务。"
      },
      {
        "start": 312.039,
        "text": "两个调用者竞争同一个锁目录。"
      },
      {
        "start": 314.644,
        "text": "第一个取得锁，第二个等待。"
      },
      {
        "start": 316.981,
        "text": "持锁者先刷新配置，"
      },
      {
        "start": 318.845,
        "text": "再进入受保护的业务操作。"
      },
      {
        "start": 321.194,
        "text": "完成后释放锁目录。"
      },
      {
        "start": 323.532,
        "text": "第二个随后取得锁，"
      },
      {
        "start": 325.095,
        "text": "刷新后再处理自己的任务。"
      },
      {
        "start": 327.479,
        "text": "这是集群库的一种协作封装。"
      },
      {
        "start": 330.06,
        "text": "它不是内存数据库的内部互斥锁，"
      },
      {
        "start": 332.444,
        "text": "也不能直接套到所有虚拟机操作。"
      },
      {
        "start": 335.025,
        "text": "具体业务仍要查自己的调用链。"
      }
    ]
  },
  {
    "start": 340.5,
    "end": 379.5,
    "duration": 38.352,
    "file": "audio/quorum-pmxcfs-lesson/10.mp3",
    "captions": [
      {
        "start": 340.596,
        "text": "用这些边界判断写入问题。"
      },
      {
        "start": 343.255,
        "text": "第一层，看请求是否进入文件入口。"
      },
      {
        "start": 346.542,
        "text": "第二层，看本机是否有仲裁。"
      },
      {
        "start": 349.343,
        "text": "第三层，看消息能否正常交付。"
      },
      {
        "start": 352.595,
        "text": "第四层，看本地处理和返回。"
      },
      {
        "start": 355.454,
        "text": "业务还有自己使用的锁。"
      },
      {
        "start": 357.757,
        "text": "能读取文件，不能证明写入正常。"
      },
      {
        "start": 360.812,
        "text": "调用返回，也不能证明，"
      },
      {
        "start": 362.931,
        "text": "收齐了所有节点的磁盘确认。"
      },
      {
        "start": 365.431,
        "text": "新节点加入、状态重新同步，"
      },
      {
        "start": 368.104,
        "text": "数据库错误和并发冲突，"
      },
      {
        "start": 370.014,
        "text": "需要各自的异常流程。"
      },
      {
        "start": 372.086,
        "text": "本集健康路径没有覆盖它们。"
      },
      {
        "start": 374.725,
        "text": "先辨认观察结果，"
      },
      {
        "start": 376.275,
        "text": "再把证据放回对应层次。"
      }
    ]
  },
  {
    "start": 380.5,
    "end": 419.5,
    "duration": 37.632,
    "file": "audio/quorum-pmxcfs-lesson/11.mp3",
    "captions": [
      {
        "start": 380.596,
        "text": "最后做两道判断题。"
      },
      {
        "start": 382.606,
        "text": "丙还有本地配置数据库，"
      },
      {
        "start": 384.887,
        "text": "失去仲裁后就能独立写入吗？"
      },
      {
        "start": 387.606,
        "text": "先看图，想一想。"
      },
      {
        "start": 389.701,
        "text": "答案是不能。"
      },
      {
        "start": 391.021,
        "text": "再看甲的写调用返回。"
      },
      {
        "start": 393.37,
        "text": "这是否等于收齐全节点落盘回执？"
      },
      {
        "start": 396.634,
        "text": "停下来，找出真正的返回路径。"
      },
      {
        "start": 399.609,
        "text": "答案也不能这样推断。"
      },
      {
        "start": 401.495,
        "text": "现在重放那条健康路径。"
      },
      {
        "start": 403.868,
        "text": "文件入口先检查仲裁，"
      },
      {
        "start": 405.847,
        "text": "操作通过组通信交付，"
      },
      {
        "start": 407.803,
        "text": "各节点更新本地副本，"
      },
      {
        "start": 409.505,
        "text": "调用者取得本机处理结果。"
      },
      {
        "start": 411.75,
        "text": "入口、顺序、返回条件和持久性，"
      },
      {
        "start": 415.546,
        "text": "是四个需要分别理解的问题。"
      }
    ]
  }
]
