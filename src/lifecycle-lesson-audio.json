[
  {
    "start": 0,
    "end": 35,
    "duration": 27.024,
    "file": "audio/quorum-lifecycle-lesson/01.mp3",
    "captions": [
      {
        "start": 0.096,
        "text": "点击启动之后，"
      },
      {
        "start": 1.624,
        "text": "界面里的成功到底指什么？"
      },
      {
        "start": 3.877,
        "text": "请求被接收，"
      },
      {
        "start": 5.093,
        "text": "后台任务结束，"
      },
      {
        "start": 6.262,
        "text": "虚拟机正在运行，"
      },
      {
        "start": 7.859,
        "text": "应用可以提供服务，"
      },
      {
        "start": 9.201,
        "text": "这是四个不同的问题。"
      },
      {
        "start": 10.857,
        "text": "这一集沿着同一条链路，"
      },
      {
        "start": 13.148,
        "text": "看见每一层的内部动作。"
      },
      {
        "start": 15.093,
        "text": "我们固定普通冷启动："
      },
      {
        "start": 17.095,
        "text": "目标节点就是当前入口，"
      },
      {
        "start": 19.097,
        "text": "虚拟机最初已经停止，"
      },
      {
        "start": 20.926,
        "text": "也不由高可用管理。"
      },
      {
        "start": 22.616,
        "text": "图中的秒数是教学节奏，"
      },
      {
        "start": 24.826,
        "text": "不是实际启动耗时。"
      }
    ]
  },
  {
    "start": 35,
    "end": 85,
    "duration": 45.768,
    "file": "audio/quorum-lifecycle-lesson/02.mp3",
    "captions": [
      {
        "start": 35.096,
        "text": "现在发出启动请求。"
      },
      {
        "start": 37.118,
        "text": "它包含目标节点和虚拟机号，"
      },
      {
        "start": 39.699,
        "text": "动作是启动，"
      },
      {
        "start": 40.833,
        "text": "使用的是管理接口。"
      },
      {
        "start": 42.569,
        "text": "请求进入代理进程。"
      },
      {
        "start": 44.676,
        "text": "代理对外提供加密连接，"
      },
      {
        "start": 46.516,
        "text": "以低权限用户运行。"
      },
      {
        "start": 48.368,
        "text": "需要特权的操作，"
      },
      {
        "start": 49.792,
        "text": "转交本机的守护进程。"
      },
      {
        "start": 51.979,
        "text": "后者具有执行启动的权限，"
      },
      {
        "start": 54.074,
        "text": "但请求仍需符合访问规则。"
      },
      {
        "start": 56.678,
        "text": "本例用户拥有电源管理权限，"
      },
      {
        "start": 59.236,
        "text": "集群也具备法定票数。"
      },
      {
        "start": 61.47,
        "text": "前置条件通过之后，"
      },
      {
        "start": 63.09,
        "text": "才会进入普通启动分支。"
      },
      {
        "start": 65.301,
        "text": "如果虚拟机由高可用管理，"
      },
      {
        "start": 67.523,
        "text": "接口走的是另一条路径，"
      },
      {
        "start": 69.225,
        "text": "它请求高可用管理器启动。"
      },
      {
        "start": 71.516,
        "text": "这不是本片的后台任务。"
      },
      {
        "start": 73.542,
        "text": "跨节点转发也另有一跳，"
      },
      {
        "start": 75.706,
        "text": "本次先固定在目标节点，"
      },
      {
        "start": 77.766,
        "text": "集中观察请求怎样变成任务。"
      }
    ]
  },
  {
    "start": 85,
    "end": 140,
    "duration": 50.52,
    "file": "audio/quorum-lifecycle-lesson/03.mp3",
    "captions": [
      {
        "start": 85.096,
        "text": "服务派生任务子进程。"
      },
      {
        "start": 87.118,
        "text": "这个任务的类型是启动，"
      },
      {
        "start": 88.935,
        "text": "它拥有自己的进程身份。"
      },
      {
        "start": 90.984,
        "text": "父子进程先完成初始化握手，"
      },
      {
        "start": 93.704,
        "text": "然后两条路径并行推进。"
      },
      {
        "start": 95.995,
        "text": "一条把任务号返回客户端，"
      },
      {
        "start": 98.079,
        "text": "另一条在后台执行启动。"
      },
      {
        "start": 100.301,
        "text": "收到任务号，"
      },
      {
        "start": 101.505,
        "text": "只说明有了跟踪任务的入口，"
      },
      {
        "start": 103.831,
        "text": "不能据此宣称虚拟机已启动。"
      },
      {
        "start": 106.493,
        "text": "现在展开任务号的结构。"
      },
      {
        "start": 108.727,
        "text": "它包含节点，"
      },
      {
        "start": 109.907,
        "text": "任务进程号与进程起始标识，"
      },
      {
        "start": 112.581,
        "text": "以及任务开始时间。"
      },
      {
        "start": 114.34,
        "text": "还包含任务类型、对象编号，"
      },
      {
        "start": 116.817,
        "text": "和发起任务的用户。"
      },
      {
        "start": 118.484,
        "text": "任务进程号不是虚拟机进程号，"
      },
      {
        "start": 121.053,
        "text": "虚拟机号也不是任务号。"
      },
      {
        "start": 123.218,
        "text": "这些字段用于定位这次操作，"
      },
      {
        "start": 125.66,
        "text": "而不是存放业务就绪结果。"
      },
      {
        "start": 127.975,
        "text": "网络响应与后台执行相互独立，"
      },
      {
        "start": 130.532,
        "text": "动画展示一种合法的顺序，"
      },
      {
        "start": 132.523,
        "text": "不保证每次都以同样间隔发生。"
      }
    ]
  },
  {
    "start": 140,
    "end": 195,
    "duration": 49.992,
    "file": "audio/quorum-lifecycle-lesson/04.mp3",
    "captions": [
      {
        "start": 140.096,
        "text": "后台进入配置互斥区。"
      },
      {
        "start": 142.5,
        "text": "先取得这台虚拟机的配置锁，"
      },
      {
        "start": 144.479,
        "text": "再读取配置并检查状态。"
      },
      {
        "start": 146.944,
        "text": "这把锁保护同一节点上，"
      },
      {
        "start": 148.785,
        "text": "同一虚拟机的相关操作，"
      },
      {
        "start": 150.706,
        "text": "避免它们同时修改关键状态。"
      },
      {
        "start": 153.229,
        "text": "它不是让虚拟机一直持有的锁。"
      },
      {
        "start": 155.833,
        "text": "现在区分两种锁。"
      },
      {
        "start": 157.72,
        "text": "左边是操作期间的互斥，"
      },
      {
        "start": 159.63,
        "text": "执行结束或者抛出异常后，"
      },
      {
        "start": 161.863,
        "text": "相关锁句柄会被释放。"
      },
      {
        "start": 163.9,
        "text": "右边是配置里的业务标记，"
      },
      {
        "start": 165.972,
        "text": "它可能表示迁移等操作，"
      },
      {
        "start": 168.357,
        "text": "仍在占用这台虚拟机。"
      },
      {
        "start": 170.359,
        "text": "拿到互斥锁，"
      },
      {
        "start": 171.562,
        "text": "并不等于业务标记允许启动。"
      },
      {
        "start": 174.005,
        "text": "标记不允许时，"
      },
      {
        "start": 175.37,
        "text": "检查会抛出错误。"
      },
      {
        "start": 177.095,
        "text": "如果互斥锁被另一操作占用，"
      },
      {
        "start": 179.19,
        "text": "新任务可能等待，"
      },
      {
        "start": 180.613,
        "text": "超过获取锁的时限就失败。"
      },
      {
        "start": 183.067,
        "text": "等待不是已经开始启动，"
      },
      {
        "start": 184.954,
        "text": "更不是让用户直接清除锁。"
      },
      {
        "start": 187.141,
        "text": "本例没有冲突，检查通过。"
      }
    ]
  },
  {
    "start": 195,
    "end": 255,
    "duration": 57.192,
    "file": "audio/quorum-lifecycle-lesson/05.mp3",
    "captions": [
      {
        "start": 195.096,
        "text": "接着准备启动资源。"
      },
      {
        "start": 197.083,
        "text": "配置里的磁盘引用，"
      },
      {
        "start": 198.553,
        "text": "需要对应可访问的存储卷。"
      },
      {
        "start": 200.903,
        "text": "启动编排先激活相关卷，"
      },
      {
        "start": 203.322,
        "text": "再生成虚拟机启动参数。"
      },
      {
        "start": 205.822,
        "text": "处理配置并不复制磁盘内容，"
      },
      {
        "start": 208.333,
        "text": "也不代表客户机已经执行指令。"
      },
      {
        "start": 210.926,
        "text": "参数准备完成，"
      },
      {
        "start": 212.477,
        "text": "编排进入系统资源作用域，"
      },
      {
        "start": 214.618,
        "text": "然后运行虚拟机进程。"
      },
      {
        "start": 216.794,
        "text": "图中把辅助设备准备，"
      },
      {
        "start": 218.692,
        "text": "和后续控制步骤合并显示。"
      },
      {
        "start": 221.111,
        "text": "真实路径还受到虚拟硬件，"
      },
      {
        "start": 223.472,
        "text": "存储配置及启动选项影响。"
      },
      {
        "start": 226.1,
        "text": "虚拟机进程现在已经存在。"
      },
      {
        "start": 228.472,
        "text": "它包含执行和设备相关状态，"
      },
      {
        "start": 231.123,
        "text": "客户机可以继续自己的启动。"
      },
      {
        "start": 233.414,
        "text": "后台仍要完成后置处理。"
      },
      {
        "start": 235.961,
        "text": "正常返回后，任务写入成功。"
      },
      {
        "start": 239.005,
        "text": "配置互斥锁已经释放，"
      },
      {
        "start": 240.799,
        "text": "而虚拟机进程继续运行。"
      },
      {
        "start": 243.148,
        "text": "这说明任务的生命周期，"
      },
      {
        "start": 245.012,
        "text": "和虚拟机的生命周期不同。"
      },
      {
        "start": 247.292,
        "text": "本例没有错误或警告，"
      },
      {
        "start": 249.201,
        "text": "但仍没有验证应用是否就绪。"
      }
    ]
  },
  {
    "start": 255,
    "end": 310,
    "duration": 52.368,
    "file": "audio/quorum-lifecycle-lesson/06.mp3",
    "captions": [
      {
        "start": 255.096,
        "text": "现在客户端分别读取状态。"
      },
      {
        "start": 257.616,
        "text": "先按任务号查询任务，"
      },
      {
        "start": 259.352,
        "text": "得到任务已经结束。"
      },
      {
        "start": 261.146,
        "text": "还要读取它的退出结果，"
      },
      {
        "start": 262.998,
        "text": "本例结果是成功。"
      },
      {
        "start": 264.803,
        "text": "任务日志记录这次操作的输出，"
      },
      {
        "start": 267.245,
        "text": "正常结果、错误或警告，"
      },
      {
        "start": 269.606,
        "text": "需要结合具体内容判断。"
      },
      {
        "start": 271.759,
        "text": "任务结束不自动代表成功。"
      },
      {
        "start": 274.259,
        "text": "再按虚拟机号查询运行状态。"
      },
      {
        "start": 277.199,
        "text": "本例返回正在运行，"
      },
      {
        "start": 278.947,
        "text": "它依据的是虚拟机进程状态，"
      },
      {
        "start": 281.25,
        "text": "不是应用接口的健康检查。"
      },
      {
        "start": 283.6,
        "text": "同一个停止字段，"
      },
      {
        "start": 285.093,
        "text": "用在任务上表示任务结束，"
      },
      {
        "start": 287.338,
        "text": "用在虚拟机上才讨论它的状态。"
      },
      {
        "start": 289.988,
        "text": "图中的两次查询都经过，"
      },
      {
        "start": 291.933,
        "text": "前面相同的管理接口路径。"
      },
      {
        "start": 294.109,
        "text": "为了让证据更清楚，"
      },
      {
        "start": 295.752,
        "text": "这里折叠了代理转发细节。"
      },
      {
        "start": 298.044,
        "text": "任务成功加上进程运行，"
      },
      {
        "start": 300.44,
        "text": "仍不能证明登录、数据库，"
      },
      {
        "start": 302.708,
        "text": "或外部依赖已经正常。"
      },
      {
        "start": 304.769,
        "text": "这些需要独立的应用验收。"
      }
    ]
  },
  {
    "start": 310,
    "end": 365,
    "duration": 51.624,
    "file": "audio/quorum-lifecycle-lesson/07.mp3",
    "captions": [
      {
        "start": 310.096,
        "text": "下面是三个独立失败对照。"
      },
      {
        "start": 312.708,
        "text": "它们不继承前面成功的状态。"
      },
      {
        "start": 315.185,
        "text": "第一种，重复发出启动请求。"
      },
      {
        "start": 317.951,
        "text": "假设第一项任务已经完成，"
      },
      {
        "start": 319.942,
        "text": "虚拟机进程仍然运行。"
      },
      {
        "start": 322.257,
        "text": "第二项后台任务取得锁后，"
      },
      {
        "start": 324.248,
        "text": "检查发现它已经运行，"
      },
      {
        "start": 326.366,
        "text": "于是这次任务报告错误。"
      },
      {
        "start": 328.356,
        "text": "旧进程没有因此变成停止，"
      },
      {
        "start": 330.787,
        "text": "也不应该再创建一个进程。"
      },
      {
        "start": 332.778,
        "text": "第二种，配置有迁移锁标记。"
      },
      {
        "start": 335.602,
        "text": "普通启动没有跳过锁检查，"
      },
      {
        "start": 337.94,
        "text": "因此在资源准备之前被拒绝。"
      },
      {
        "start": 340.729,
        "text": "这不同于等待操作互斥锁。"
      },
      {
        "start": 343.194,
        "text": "第三种，启动前激活卷失败。"
      },
      {
        "start": 345.995,
        "text": "本例尚未运行虚拟机命令，"
      },
      {
        "start": 348.09,
        "text": "错误沿调用链返回任务，"
      },
      {
        "start": 350.058,
        "text": "客户端需要查看具体日志。"
      },
      {
        "start": 352.407,
        "text": "这三种任务都可能结束，"
      },
      {
        "start": 354.282,
        "text": "但虚拟机的真实状态不同。"
      },
      {
        "start": 356.528,
        "text": "不能仅凭任务的停止字段，"
      },
      {
        "start": 358.727,
        "text": "决定重试、清锁或接管。"
      }
    ]
  },
  {
    "start": 365,
    "end": 420,
    "duration": 52.056,
    "file": "audio/quorum-lifecycle-lesson/08.mp3",
    "captions": [
      {
        "start": 365.096,
        "text": "最后回到新的一次正常启动。"
      },
      {
        "start": 367.477,
        "text": "清空前面案例的结果。"
      },
      {
        "start": 369.502,
        "text": "请求进入代理，"
      },
      {
        "start": 370.833,
        "text": "再到本机特权服务。"
      },
      {
        "start": 372.882,
        "text": "前置条件通过，创建后台任务。"
      },
      {
        "start": 375.868,
        "text": "任务号沿响应路径返回，"
      },
      {
        "start": 378.079,
        "text": "后台独立取得配置锁。"
      },
      {
        "start": 380.069,
        "text": "读取配置，检查当前状态。"
      },
      {
        "start": 383.044,
        "text": "准备存储卷和启动参数，"
      },
      {
        "start": 385.162,
        "text": "再运行虚拟机进程。"
      },
      {
        "start": 387.199,
        "text": "后置处理结束，任务成功。"
      },
      {
        "start": 389.85,
        "text": "锁被释放，虚拟机继续运行。"
      },
      {
        "start": 392.801,
        "text": "客户端分别查询任务，"
      },
      {
        "start": 394.549,
        "text": "以及虚拟机的运行状态。"
      },
      {
        "start": 396.62,
        "text": "应用仍然需要独立验证。"
      },
      {
        "start": 398.819,
        "text": "以后看到界面里的一个结果，"
      },
      {
        "start": 400.683,
        "text": "先问它描述的是哪一个对象，"
      },
      {
        "start": 402.847,
        "text": "来自哪一次请求或任务，"
      },
      {
        "start": 404.606,
        "text": "覆盖的是哪一层证据。"
      },
      {
        "start": 406.343,
        "text": "定位启动问题时，"
      },
      {
        "start": 407.812,
        "text": "先确定请求有没有进入任务，"
      },
      {
        "start": 409.954,
        "text": "再沿日志和状态查到失败阶段，"
      },
      {
        "start": 412.905,
        "text": "就不会把所有问题混成，"
      },
      {
        "start": 414.641,
        "text": "虚拟机没有启动这一句话。"
      }
    ]
  }
]
