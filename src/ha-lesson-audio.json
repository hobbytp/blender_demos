[
  {
    "start": 0.5,
    "end": 29.5,
    "duration": 23.088,
    "file": "audio/quorum-ha-lesson/01.mp3",
    "captions": [
      {
        "start": 0.596,
        "text": "三台节点组成一个集群。"
      },
      {
        "start": 3.104,
        "text": "虚拟机一百在C上运行。"
      },
      {
        "start": 5.488,
        "text": "现在，集群通信断开。"
      },
      {
        "start": 7.965,
        "text": "但业务和存储路径仍通，"
      },
      {
        "start": 9.979,
        "text": "旧虚拟机仍能读写磁盘。"
      },
      {
        "start": 12.456,
        "text": "多数侧看不到C，"
      },
      {
        "start": 13.926,
        "text": "却不能据此认定它已停止。"
      },
      {
        "start": 16.495,
        "text": "如果再启动另一份实例，"
      },
      {
        "start": 18.301,
        "text": "两份就可能同时写同一磁盘。"
      },
      {
        "start": 21.125,
        "text": "什么时候，才敢接管？"
      }
    ]
  },
  {
    "start": 30.5,
    "end": 64.5,
    "duration": 27.408,
    "file": "audio/quorum-ha-lesson/02.mp3",
    "captions": [
      {
        "start": 30.596,
        "text": "先回到故障前，"
      },
      {
        "start": 31.95,
        "text": "打开两台节点的内部。"
      },
      {
        "start": 33.764,
        "text": "B的CRM持有管理锁，"
      },
      {
        "start": 35.882,
        "text": "负责集群资源决策。"
      },
      {
        "start": 37.699,
        "text": "C的LRM持有本机代理锁，"
      },
      {
        "start": 40.164,
        "text": "负责执行本地资源动作。"
      },
      {
        "start": 42.271,
        "text": "每台都有这两类进程，"
      },
      {
        "start": 44.47,
        "text": "但不都拥有管理决策权。"
      },
      {
        "start": 46.553,
        "text": "配置、锁和管理状态，"
      },
      {
        "start": 48.729,
        "text": "保存在各自的配置文件系统。"
      },
      {
        "start": 51.148,
        "text": "下方的共享存储保存磁盘。"
      },
      {
        "start": 53.845,
        "text": "配置协作和磁盘访问，"
      },
      {
        "start": 55.836,
        "text": "是两条不同的路径。"
      }
    ]
  },
  {
    "start": 65.5,
    "end": 99.5,
    "duration": 27.888,
    "file": "audio/quorum-ha-lesson/03.mp3",
    "captions": [
      {
        "start": 65.596,
        "text": "正常时，LRM请求续锁。"
      },
      {
        "start": 68.347,
        "text": "更新成功后，"
      },
      {
        "start": 69.516,
        "text": "才向本机复用器发送续期。"
      },
      {
        "start": 72.271,
        "text": "复用器再给看门狗喂狗。"
      },
      {
        "start": 74.586,
        "text": "这是本地调用，"
      },
      {
        "start": 75.894,
        "text": "不是发给其他节点的心跳。"
      },
      {
        "start": 78.093,
        "text": "另一条路径负责管理协作。"
      },
      {
        "start": 80.604,
        "text": "CRM发布管理状态，"
      },
      {
        "start": 82.491,
        "text": "配置层把状态提供给LRM。"
      },
      {
        "start": 85.245,
        "text": "LRM执行后写回结果，"
      },
      {
        "start": 87.109,
        "text": "CRM再读取结果。"
      },
      {
        "start": 88.949,
        "text": "看清短脉冲和跨节点消息，"
      },
      {
        "start": 91.333,
        "text": "它们承担不同的工作。"
      }
    ]
  },
  {
    "start": 100.5,
    "end": 134.5,
    "duration": 27.0,
    "file": "audio/quorum-ha-lesson/04.mp3",
    "captions": [
      {
        "start": 100.596,
        "text": "现在进入持续分区。"
      },
      {
        "start": 102.688,
        "text": "C的所有集群通信路径断开，"
      },
      {
        "start": 105.095,
        "text": "并非主机全部网络失效。"
      },
      {
        "start": 107.306,
        "text": "成员关系重新形成，"
      },
      {
        "start": 109.146,
        "text": "A和B这一侧有两票，"
      },
      {
        "start": 110.894,
        "text": "满足三票集群的仲裁条件。"
      },
      {
        "start": 113.359,
        "text": "C只有一票，不满足条件。"
      },
      {
        "start": 116.021,
        "text": "这里没有外部投票设备，"
      },
      {
        "start": 117.745,
        "text": "也没有人工改变票数。"
      },
      {
        "start": 119.69,
        "text": "多数侧能继续集群管理，"
      },
      {
        "start": 121.634,
        "text": "但请看，磁盘读写还在继续。"
      },
      {
        "start": 124.528,
        "text": "票数没有让旧实例立即退出。"
      }
    ]
  },
  {
    "start": 135.5,
    "end": 169.5,
    "duration": 26.568,
    "file": "audio/quorum-ha-lesson/05.mp3",
    "captions": [
      {
        "start": 135.596,
        "text": "放大C的内部。"
      },
      {
        "start": 137.062,
        "text": "失去仲裁后，"
      },
      {
        "start": 138.359,
        "text": "本机配置文件系统只读。"
      },
      {
        "start": 140.593,
        "text": "LRM不能成功更新代理锁，"
      },
      {
        "start": 142.537,
        "text": "进入失去代理锁的状态。"
      },
      {
        "start": 144.516,
        "text": "正常的本地续期中止。"
      },
      {
        "start": 146.796,
        "text": "但这里没有一条箭头，"
      },
      {
        "start": 148.405,
        "text": "直接命令虚拟机立刻关机。"
      },
      {
        "start": 151.009,
        "text": "已有进程仍可能继续服务。"
      },
      {
        "start": 153.532,
        "text": "集群管理能力已经丢失，"
      },
      {
        "start": 155.407,
        "text": "业务执行却还未必停止。"
      },
      {
        "start": 157.699,
        "text": "系统需要保护机制，"
      },
      {
        "start": 159.424,
        "text": "结束这种危险的不确定性。"
      }
    ]
  },
  {
    "start": 170.5,
    "end": 209.5,
    "duration": 33.24,
    "file": "audio/quorum-ha-lesson/06.mp3",
    "captions": [
      {
        "start": 170.596,
        "text": "看清看门狗的两层监督。"
      },
      {
        "start": 172.884,
        "text": "第一层，LRM向复用器续期。"
      },
      {
        "start": 175.685,
        "text": "第二层，复用器给设备喂狗。"
      },
      {
        "start": 178.382,
        "text": "客户端持续没有有效续期，"
      },
      {
        "start": 180.604,
        "text": "复用器检测到超期，"
      },
      {
        "start": 182.248,
        "text": "于是停止设备喂狗。"
      },
      {
        "start": 184.157,
        "text": "设备随后超时，触发主机复位。"
      },
      {
        "start": 187.282,
        "text": "C上的进程和旧虚拟机停止，"
      },
      {
        "start": 189.736,
        "text": "业务和磁盘请求也停止。"
      },
      {
        "start": 191.9,
        "text": "前提是看门狗已武装，"
      },
      {
        "start": 194.204,
        "text": "而且确实能让主机复位。"
      },
      {
        "start": 196.345,
        "text": "这是观众看到的本机剖面，"
      },
      {
        "start": 198.289,
        "text": "不代表B收到了关机回执。"
      },
      {
        "start": 200.836,
        "text": "播放秒数也不是协议计时。"
      }
    ]
  },
  {
    "start": 210.5,
    "end": 249.5,
    "duration": 30.888,
    "file": "audio/quorum-ha-lesson/07.mp3",
    "captions": [
      {
        "start": 210.596,
        "text": "回看同时发生的另一条路径。"
      },
      {
        "start": 213.197,
        "text": "B的CRM把失联的C，"
      },
      {
        "start": 215.35,
        "text": "视为状态未知。"
      },
      {
        "start": 216.97,
        "text": "未知，意味着不能排除，"
      },
      {
        "start": 219.447,
        "text": "它仍然运行着旧实例。"
      },
      {
        "start": 221.426,
        "text": "经过离线延迟判断，"
      },
      {
        "start": 223.336,
        "text": "服务进入等待隔离的状态。"
      },
      {
        "start": 225.639,
        "text": "CRM尝试取得C的代理锁。"
      },
      {
        "start": 228.301,
        "text": "获取没有成功，"
      },
      {
        "start": 229.609,
        "text": "恢复路径就不能放行。"
      },
      {
        "start": 231.819,
        "text": "多数侧的等待，"
      },
      {
        "start": 233.012,
        "text": "和少数侧的看门狗保护，"
      },
      {
        "start": 234.887,
        "text": "是配套工作的两条路径。"
      },
      {
        "start": 237.062,
        "text": "不能把任意一个超时值，"
      },
      {
        "start": 238.833,
        "text": "当成端到端接管时间。"
      }
    ]
  },
  {
    "start": 250.5,
    "end": 284.5,
    "duration": 25.632,
    "file": "audio/quorum-ha-lesson/08.mp3",
    "captions": [
      {
        "start": 250.596,
        "text": "现在，锁操作返回成功。"
      },
      {
        "start": 253.393,
        "text": "B取得了旧节点的代理锁。"
      },
      {
        "start": 255.697,
        "text": "隔离判定在这里确认，"
      },
      {
        "start": 257.329,
        "text": "服务随后进入恢复阶段。"
      },
      {
        "start": 259.539,
        "text": "成功结果来自集群锁操作，"
      },
      {
        "start": 261.9,
        "text": "没有C发来的关机确认。"
      },
      {
        "start": 263.914,
        "text": "这也不是说一个普通文件锁，"
      },
      {
        "start": 265.847,
        "text": "能把远程主机关掉。"
      },
      {
        "start": 267.734,
        "text": "PVE把锁的有效性约束，"
      },
      {
        "start": 269.794,
        "text": "与旧节点的看门狗保护配合，"
      },
      {
        "start": 271.854,
        "text": "建立安全恢复的条件。"
      },
      {
        "start": 273.833,
        "text": "两部分都不能省略。"
      }
    ]
  },
  {
    "start": 285.5,
    "end": 329.5,
    "duration": 32.112,
    "file": "audio/quorum-ha-lesson/09.mp3",
    "captions": [
      {
        "start": 285.596,
        "text": "恢复阶段先选择目标。"
      },
      {
        "start": 287.884,
        "text": "根据本例的放置规则，"
      },
      {
        "start": 289.655,
        "text": "以及资源和网络条件，"
      },
      {
        "start": 291.345,
        "text": "CRM选择了B。"
      },
      {
        "start": 293.231,
        "text": "配置的节点归属转到B，"
      },
      {
        "start": 295.118,
        "text": "磁盘仍留在共享存储。"
      },
      {
        "start": 297.433,
        "text": "CRM发布新的管理状态，"
      },
      {
        "start": 299.458,
        "text": "B的LRM读取本机任务。"
      },
      {
        "start": 302.028,
        "text": "它建立自己的锁与保护，"
      },
      {
        "start": 303.567,
        "text": "再通过本地资源代理，"
      },
      {
        "start": 305.118,
        "text": "调用QEMU管理接口。"
      },
      {
        "start": 307.444,
        "text": "新的虚拟机在B上启动，"
      },
      {
        "start": 309.238,
        "text": "执行结果写回配置层，"
      },
      {
        "start": 310.928,
        "text": "CRM读取这个结果。"
      },
      {
        "start": 312.815,
        "text": "这里经过共享管理状态，"
      },
      {
        "start": 314.655,
        "text": "不是CRM直接远程启动。"
      }
    ]
  },
  {
    "start": 330.5,
    "end": 364.5,
    "duration": 28.536,
    "file": "audio/quorum-ha-lesson/10.mp3",
    "captions": [
      {
        "start": 330.596,
        "text": "新实例开始读取共享磁盘，"
      },
      {
        "start": 333.166,
        "text": "启动系统，再恢复应用。"
      },
      {
        "start": 335.396,
        "text": "旧实例的运行内存，"
      },
      {
        "start": 337.097,
        "text": "没有在这次故障中传过来。"
      },
      {
        "start": 339.215,
        "text": "所以这是故障后的重启，"
      },
      {
        "start": 341.31,
        "text": "并不是热迁移。"
      },
      {
        "start": 342.78,
        "text": "请区分三件事："
      },
      {
        "start": 344.25,
        "text": "管理期望它运行，"
      },
      {
        "start": 345.743,
        "text": "QEMU进程确实运行，"
      },
      {
        "start": 347.896,
        "text": "用户业务真正可用。"
      },
      {
        "start": 349.771,
        "text": "独立业务探测成功后，"
      },
      {
        "start": 351.461,
        "text": "才显示应用就绪。"
      },
      {
        "start": 353.255,
        "text": "共享磁盘不保证缓存已落盘，"
      },
      {
        "start": 355.998,
        "text": "也不替应用完成一致性恢复。"
      }
    ]
  },
  {
    "start": 365.5,
    "end": 374.5,
    "duration": 7.56,
    "file": "audio/quorum-ha-lesson/11.mp3",
    "captions": [
      {
        "start": 365.596,
        "text": "做个判断。"
      },
      {
        "start": 366.9,
        "text": "多数侧已经有仲裁，"
      },
      {
        "start": 368.625,
        "text": "但还没取得旧节点代理锁。"
      },
      {
        "start": 370.627,
        "text": "现在能启动恢复实例吗？"
      }
    ]
  },
  {
    "start": 380,
    "end": 394.5,
    "duration": 13.296,
    "file": "audio/quorum-ha-lesson/12.mp3",
    "captions": [
      {
        "start": 380.096,
        "text": "答案是继续等待。"
      },
      {
        "start": 381.806,
        "text": "仲裁允许继续集群管理，"
      },
      {
        "start": 384.039,
        "text": "隔离条件约束旧实例干扰。"
      },
      {
        "start": 386.435,
        "text": "目标还要具备运行条件。"
      },
      {
        "start": 388.738,
        "text": "不能把看不到旧节点，"
      },
      {
        "start": 390.359,
        "text": "当成旧实例已经安全退出。"
      }
    ]
  },
  {
    "start": 395.5,
    "end": 419.5,
    "duration": 22.512,
    "file": "audio/quorum-ha-lesson/13.mp3",
    "captions": [
      {
        "start": 395.596,
        "text": "把两条因果链连起来。"
      },
      {
        "start": 397.63,
        "text": "C失去续锁能力，"
      },
      {
        "start": 399.1,
        "text": "看门狗保护让旧实例退出。"
      },
      {
        "start": 401.738,
        "text": "多数侧取得安全锁条件后，"
      },
      {
        "start": 403.822,
        "text": "恢复配置归属，"
      },
      {
        "start": 405.188,
        "text": "由目标节点启动资源。"
      },
      {
        "start": 407.248,
        "text": "磁盘留在原处，"
      },
      {
        "start": 408.764,
        "text": "应用可用需要独立观察。"
      },
      {
        "start": 411.299,
        "text": "下一集，保留这张拓扑，"
      },
      {
        "start": 413.451,
        "text": "看看节点仍能协作时，"
      },
      {
        "start": 415.245,
        "text": "热迁移怎样转移运行状态。"
      }
    ]
  }
]
