[
  {
    "start": 0,
    "end": 35,
    "duration": 28.632,
    "file": "audio/quorum-restore-lesson/01.mp3",
    "captions": [
      {
        "start": 0.096,
        "text": "备份任务成功，"
      },
      {
        "start": 1.566,
        "text": "只是恢复链条的起点。"
      },
      {
        "start": 3.449,
        "text": "归档能否还原磁盘，"
      },
      {
        "start": 5.104,
        "text": "虚拟机能否启动，"
      },
      {
        "start": 6.655,
        "text": "数据库能否接受连接，"
      },
      {
        "start": 8.518,
        "text": "业务数据是否符合预期，"
      },
      {
        "start": 10.428,
        "text": "是四个不同的问题。"
      },
      {
        "start": 12.107,
        "text": "本集沿用同一张拓扑图，"
      },
      {
        "start": 14.086,
        "text": "把每层内部动作展开。"
      },
      {
        "start": 16.076,
        "text": "先看恢复点能有多旧，"
      },
      {
        "start": 17.94,
        "text": "再看服务要多久回来。"
      },
      {
        "start": 19.988,
        "text": "这两个目标由业务提出，"
      },
      {
        "start": 21.968,
        "text": "不能从绿色任务图标推算。"
      },
      {
        "start": 24.143,
        "text": "我们使用隔离恢复的示意，"
      },
      {
        "start": 26.03,
        "text": "不把动画当作实机演练。"
      }
    ]
  },
  {
    "start": 35,
    "end": 85,
    "duration": 46.008,
    "file": "audio/quorum-restore-lesson/02.mp3",
    "captions": [
      {
        "start": 35.096,
        "text": "先看数据时间轴。"
      },
      {
        "start": 37.095,
        "text": "业务要求的恢复点目标，"
      },
      {
        "start": 38.854,
        "text": "简称 RPO。"
      },
      {
        "start": 40.718,
        "text": "这里要求最多回退十五分钟。"
      },
      {
        "start": 43.264,
        "text": "假设十点发生中断，"
      },
      {
        "start": 45.058,
        "text": "目标边界就是九点四十五分。"
      },
      {
        "start": 47.627,
        "text": "手头有两份候选备份。"
      },
      {
        "start": 49.942,
        "text": "第一份的一致性时间点，"
      },
      {
        "start": 51.69,
        "text": "是九点三十分，"
      },
      {
        "start": 53.113,
        "text": "九点四十分才复制完成。"
      },
      {
        "start": 55.613,
        "text": "第二份指向九点五十分，"
      },
      {
        "start": 57.627,
        "text": "但备份任务已经失败。"
      },
      {
        "start": 59.618,
        "text": "不能因为它时间更新，"
      },
      {
        "start": 61.273,
        "text": "就把它当成可用恢复点。"
      },
      {
        "start": 63.206,
        "text": "当前只能选择较早的一份。"
      },
      {
        "start": 65.394,
        "text": "相对十点中断，"
      },
      {
        "start": 66.794,
        "text": "数据时间缺口是三十分钟，"
      },
      {
        "start": 68.912,
        "text": "已经超过十五分钟的要求。"
      },
      {
        "start": 70.961,
        "text": "这里比较的是数据时间点，"
      },
      {
        "start": 72.94,
        "text": "不是归档复制结束的时间。"
      },
      {
        "start": 75.058,
        "text": "具体丢了多少条业务记录，"
      },
      {
        "start": 77.072,
        "text": "还需要数据核对，"
      },
      {
        "start": 78.484,
        "text": "不能用分钟数直接换算。"
      }
    ]
  },
  {
    "start": 85,
    "end": 140,
    "duration": 50.736,
    "file": "audio/quorum-restore-lesson/03.mp3",
    "captions": [
      {
        "start": 85.096,
        "text": "带着选定的归档，"
      },
      {
        "start": 86.497,
        "text": "回到普通恢复路径。"
      },
      {
        "start": 88.403,
        "text": "操作方选择新的虚拟机编号，"
      },
      {
        "start": 90.799,
        "text": "并指定能够承载数据的存储。"
      },
      {
        "start": 93.113,
        "text": "恢复工具读取归档，"
      },
      {
        "start": 94.803,
        "text": "先取得虚拟机配置，"
      },
      {
        "start": 96.516,
        "text": "解析归档中的设备信息。"
      },
      {
        "start": 98.657,
        "text": "接着分配目标卷，"
      },
      {
        "start": 100.185,
        "text": "把归档设备映射到目标路径。"
      },
      {
        "start": 102.894,
        "text": "磁盘内容经解包器写入，"
      },
      {
        "start": 105.081,
        "text": "配置和数据走不同的步骤。"
      },
      {
        "start": 107.546,
        "text": "映射建立，"
      },
      {
        "start": 108.657,
        "text": "还不代表磁盘已经写完。"
      },
      {
        "start": 110.822,
        "text": "现在磁盘内容恢复完成。"
      },
      {
        "start": 113.299,
        "text": "解包命令成功返回后，"
      },
      {
        "start": 115.231,
        "text": "还要合并并写入最终配置。"
      },
      {
        "start": 117.731,
        "text": "这一层完成，"
      },
      {
        "start": 118.993,
        "text": "恢复任务才有成功结果。"
      },
      {
        "start": 121.458,
        "text": "我们明确关闭自动启动，"
      },
      {
        "start": 123.264,
        "text": "所以虚拟机仍然没有运行。"
      },
      {
        "start": 126.03,
        "text": "任务成功只说明本层工作完成，"
      },
      {
        "start": 128.993,
        "text": "不检查业务订单是否正确。"
      },
      {
        "start": 131.366,
        "text": "接下来还要确认启动条件，"
      },
      {
        "start": 133.461,
        "text": "不能直接把流量切回来。"
      }
    ]
  },
  {
    "start": 140,
    "end": 185,
    "duration": 42.84,
    "file": "audio/quorum-restore-lesson/04.mp3",
    "captions": [
      {
        "start": 140.096,
        "text": "恢复环境必须先隔离。"
      },
      {
        "start": 142.361,
        "text": "新编号不等于网络隔离，"
      },
      {
        "start": 144.433,
        "text": "随机网卡地址也不等于隔离。"
      },
      {
        "start": 146.979,
        "text": "还原的来宾可能保留旧地址，"
      },
      {
        "start": 149.444,
        "text": "旧凭据和定时任务。"
      },
      {
        "start": 151.643,
        "text": "如果直接接入生产网络，"
      },
      {
        "start": 153.576,
        "text": "就可能与原服务发生冲突。"
      },
      {
        "start": 155.799,
        "text": "本例由操作方核验隔离网络，"
      },
      {
        "start": 158.31,
        "text": "再检查启动所需的资源，"
      },
      {
        "start": 160.15,
        "text": "以及虚拟硬件的兼容条件。"
      },
      {
        "start": 162.442,
        "text": "这些是独立检查，"
      },
      {
        "start": 163.912,
        "text": "不是恢复工具自动证明的。"
      },
      {
        "start": 165.949,
        "text": "条件满足后，"
      },
      {
        "start": 167.002,
        "text": "操作方发出启动请求。"
      },
      {
        "start": 169.294,
        "text": "虚拟处理器开始执行，"
      },
      {
        "start": 171.319,
        "text": "来宾系统进入运行状态。"
      },
      {
        "start": 173.738,
        "text": "这时数据库还要自己启动。"
      },
      {
        "start": 176.562,
        "text": "我们保持网络隔离，"
      },
      {
        "start": 178.275,
        "text": "只让测试端访问恢复实例，"
      },
      {
        "start": 180.266,
        "text": "不在本片执行生产切换。"
      }
    ]
  },
  {
    "start": 185,
    "end": 240,
    "duration": 51.12,
    "file": "audio/quorum-restore-lesson/05.mp3",
    "captions": [
      {
        "start": 185.096,
        "text": "现在原位展开数据库。"
      },
      {
        "start": 187.431,
        "text": "本例的完整一致快照，"
      },
      {
        "start": 189.178,
        "text": "是在数据库运行时保存的。"
      },
      {
        "start": 191.482,
        "text": "恢复后启动数据库，"
      },
      {
        "start": 193.056,
        "text": "它会把这个状态，"
      },
      {
        "start": 194.306,
        "text": "视作上次没有正常关闭。"
      },
      {
        "start": 196.47,
        "text": "于是进入崩溃恢复。"
      },
      {
        "start": 198.426,
        "text": "日志保留恢复所需的信息，"
      },
      {
        "start": 200.359,
        "text": "数据页可能还需要重做。"
      },
      {
        "start": 202.535,
        "text": "启动过程读取日志，"
      },
      {
        "start": 204.387,
        "text": "把需要的修改应用到数据页。"
      },
      {
        "start": 206.921,
        "text": "画面的三个页面只是示意，"
      },
      {
        "start": 208.924,
        "text": "不代表三条事务依次提交。"
      },
      {
        "start": 211.181,
        "text": "日志回放完成之后，"
      },
      {
        "start": 212.847,
        "text": "数据库才进入可连接状态。"
      },
      {
        "start": 215.498,
        "text": "这条成功路径有明确前提："
      },
      {
        "start": 217.998,
        "text": "数据目录、日志和事务状态，"
      },
      {
        "start": 220.787,
        "text": "必须作为完整集群被恢复。"
      },
      {
        "start": 223.079,
        "text": "不能只拿一张表的文件，"
      },
      {
        "start": 224.653,
        "text": "就推断数据库能够恢复。"
      },
      {
        "start": 226.748,
        "text": "干净停库的备份，"
      },
      {
        "start": 228.287,
        "text": "也不必经历相同的崩溃恢复。"
      },
      {
        "start": 230.764,
        "text": "更关键的是，"
      },
      {
        "start": 232.037,
        "text": "日志不能凭空补出，"
      },
      {
        "start": 233.669,
        "text": "从未进入这份备份的数据。"
      }
    ]
  },
  {
    "start": 240,
    "end": 295,
    "duration": 51.168,
    "file": "audio/quorum-restore-lesson/06.mp3",
    "captions": [
      {
        "start": 240.096,
        "text": "数据库可连接了，"
      },
      {
        "start": 241.589,
        "text": "现在独立检查业务。"
      },
      {
        "start": 243.426,
        "text": "先选一个已知的订单，"
      },
      {
        "start": 245.127,
        "text": "记录它在备份时间点的预期。"
      },
      {
        "start": 247.488,
        "text": "测试端发出查询，"
      },
      {
        "start": 248.97,
        "text": "请求进入应用接口，"
      },
      {
        "start": 250.718,
        "text": "应用再向数据库查询。"
      },
      {
        "start": 252.893,
        "text": "数据库返回记录，"
      },
      {
        "start": 254.537,
        "text": "应用把结果送回测试端。"
      },
      {
        "start": 256.782,
        "text": "收到结果后再核对。"
      },
      {
        "start": 258.924,
        "text": "本例订单四十二，"
      },
      {
        "start": 260.336,
        "text": "预期和返回都是已支付。"
      },
      {
        "start": 262.65,
        "text": "于是本次读取检查通过。"
      },
      {
        "start": 265.162,
        "text": "这还不代表写入功能通过，"
      },
      {
        "start": 267.072,
        "text": "更不代表所有业务可用。"
      },
      {
        "start": 269.132,
        "text": "完整验收还要检查，"
      },
      {
        "start": 270.787,
        "text": "关键数据和约束，"
      },
      {
        "start": 272.35,
        "text": "受控的写入与读回，"
      },
      {
        "start": 273.97,
        "text": "以及登录和依赖服务。"
      },
      {
        "start": 276.007,
        "text": "真实系统还可能依赖，"
      },
      {
        "start": 277.789,
        "text": "外部队列、对象存储和密钥。"
      },
      {
        "start": 280.59,
        "text": "这些不在本例的单机范围内，"
      },
      {
        "start": 282.512,
        "text": "不能随着虚拟机启动，"
      },
      {
        "start": 284.132,
        "text": "一起自动标成绿色。"
      },
      {
        "start": 286.03,
        "text": "验收范围需要事先约定，"
      },
      {
        "start": 288.206,
        "text": "未做的检查继续标为待核验。"
      }
    ]
  },
  {
    "start": 295,
    "end": 355,
    "duration": 53.664,
    "file": "audio/quorum-restore-lesson/07.mp3",
    "captions": [
      {
        "start": 295.096,
        "text": "再看另一条时间轴。"
      },
      {
        "start": 297.037,
        "text": "恢复时间目标简称 RTO，"
      },
      {
        "start": 299.56,
        "text": "它首先是业务可接受的目标。"
      },
      {
        "start": 301.956,
        "text": "本案例约定，"
      },
      {
        "start": 302.975,
        "text": "从服务中断开始计时，"
      },
      {
        "start": 304.861,
        "text": "到约定的业务验收通过，"
      },
      {
        "start": 306.725,
        "text": "并完成服务切换才结束。"
      },
      {
        "start": 309.016,
        "text": "假设目标是三十分钟。"
      },
      {
        "start": 311.319,
        "text": "十点服务中断，"
      },
      {
        "start": 312.697,
        "text": "准备和决策用了五分钟。"
      },
      {
        "start": 314.769,
        "text": "磁盘恢复用了二十分钟。"
      },
      {
        "start": 317.234,
        "text": "接着系统启动用了三分钟，"
      },
      {
        "start": 319.688,
        "text": "数据库恢复用了四分钟。"
      },
      {
        "start": 321.898,
        "text": "业务验证又用了十分钟，"
      },
      {
        "start": 323.773,
        "text": "最后切换用了三分钟。"
      },
      {
        "start": 325.602,
        "text": "总用时四十五分钟，"
      },
      {
        "start": 327.245,
        "text": "超过三十分钟的目标。"
      },
      {
        "start": 329.178,
        "text": "不能只拿二十分钟的拷贝，"
      },
      {
        "start": 330.938,
        "text": "就宣称已经达到目标。"
      },
      {
        "start": 333.079,
        "text": "这是独立的计时算例，"
      },
      {
        "start": 334.803,
        "text": "不是前面隔离实例的实测。"
      },
      {
        "start": 337.025,
        "text": "优化也应沿这条链定位，"
      },
      {
        "start": 339.086,
        "text": "可能要提前准备资源，"
      },
      {
        "start": 340.694,
        "text": "也可能要减少数据搬运。"
      },
      {
        "start": 342.65,
        "text": "如果验证或依赖是瓶颈，"
      },
      {
        "start": 344.583,
        "text": "只提升磁盘吞吐量，"
      },
      {
        "start": 346.111,
        "text": "不会自动解决整个恢复问题。"
      }
    ]
  },
  {
    "start": 355,
    "end": 420,
    "duration": 63.096,
    "file": "audio/quorum-restore-lesson/08.mp3",
    "captions": [
      {
        "start": 355.096,
        "text": "最后看失败边界。"
      },
      {
        "start": 357.245,
        "text": "普通归档的解包如果报错，"
      },
      {
        "start": 359.502,
        "text": "这条恢复路径就不能报成功。"
      },
      {
        "start": 362.188,
        "text": "代码会进入清理并抛出错误，"
      },
      {
        "start": 364.711,
        "text": "不能把部分写入的磁盘，"
      },
      {
        "start": 366.562,
        "text": "当作已经可启动的完整实例。"
      },
      {
        "start": 368.843,
        "text": "另一种方式是在线恢复，"
      },
      {
        "start": 371.042,
        "text": "但那是备份服务器的专用路径。"
      },
      {
        "start": 373.472,
        "text": "它可以在后台复制时启动，"
      },
      {
        "start": 375.324,
        "text": "不适用于本片的普通归档。"
      },
      {
        "start": 377.639,
        "text": "在线恢复失败也有独立风险，"
      },
      {
        "start": 380.139,
        "text": "不能照搬普通恢复的状态。"
      },
      {
        "start": 382.361,
        "text": "现在重新回放正常路径。"
      },
      {
        "start": 384.699,
        "text": "归档先进入恢复工具。"
      },
      {
        "start": 386.979,
        "text": "设备映射建立。"
      },
      {
        "start": 388.738,
        "text": "磁盘内容恢复完成，"
      },
      {
        "start": 390.532,
        "text": "最终配置也写入成功。"
      },
      {
        "start": 392.766,
        "text": "核验隔离条件后启动。"
      },
      {
        "start": 394.931,
        "text": "系统运行，数据库开始恢复。"
      },
      {
        "start": 397.894,
        "text": "日志推动数据页完成重做。"
      },
      {
        "start": 400.301,
        "text": "数据库就绪。"
      },
      {
        "start": 401.817,
        "text": "业务请求往返。"
      },
      {
        "start": 403.634,
        "text": "核对结果后，本次检查通过。"
      },
      {
        "start": 406.204,
        "text": "但生产服务仍未在本片切回。"
      },
      {
        "start": 409.213,
        "text": "记住三个问题："
      },
      {
        "start": 410.648,
        "text": "数据恢复到哪个时间点？"
      },
      {
        "start": 412.743,
        "text": "约定的服务何时真正回来？"
      },
      {
        "start": 415.312,
        "text": "每个结论由什么证据支持？"
      }
    ]
  }
]
