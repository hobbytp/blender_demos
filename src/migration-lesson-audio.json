[
  {
    "start": 0.4,
    "end": 29.5,
    "duration": 27.12,
    "file": "audio/quorum-migration-lesson/01.mp3",
    "captions": [
      {
        "start": 0.496,
        "text": "上一集是故障后的重新启动。"
      },
      {
        "start": 2.969,
        "text": "这次，两个宿主机都健康，"
      },
      {
        "start": 5.562,
        "text": "我们把运行中的虚拟机，"
      },
      {
        "start": 7.159,
        "text": "从C迁移到B。"
      },
      {
        "start": 9.104,
        "text": "程序已经执行到一半，"
      },
      {
        "start": 10.909,
        "text": "内存里还有运行数据。"
      },
      {
        "start": 13.132,
        "text": "热迁移要接住这些状态。"
      },
      {
        "start": 15.597,
        "text": "但源端还在修改内存，"
      },
      {
        "start": 17.391,
        "text": "目标究竟怎么追得上？"
      },
      {
        "start": 19.057,
        "text": "本集从一个新的健康场景开始。"
      },
      {
        "start": 21.835,
        "text": "它不是上一集故障后的连续时间。"
      },
      {
        "start": 24.509,
        "text": "先观察执行，再观察数据。"
      }
    ]
  },
  {
    "start": 30.4,
    "end": 64.5,
    "duration": 29.064,
    "file": "audio/quorum-migration-lesson/02.mp3",
    "captions": [
      {
        "start": 30.496,
        "text": "先分清三条路径。"
      },
      {
        "start": 32.553,
        "text": "PVE管理迁移任务，"
      },
      {
        "start": 34.069,
        "text": "向QEMU发出控制命令。"
      },
      {
        "start": 36.673,
        "text": "运行状态的数据，"
      },
      {
        "start": 37.9,
        "text": "在两个QEMU之间传送。"
      },
      {
        "start": 40.192,
        "text": "下方的共享存储，"
      },
      {
        "start": 41.789,
        "text": "仍然保存同一块虚拟磁盘。"
      },
      {
        "start": 44.462,
        "text": "Corosync不运输这些内存。"
      },
      {
        "start": 46.858,
        "text": "三条路径代表不同职责，"
      },
      {
        "start": 49.173,
        "text": "不要求使用三张物理网卡。"
      },
      {
        "start": 51.534,
        "text": "管理命令不是内存数据包。"
      },
      {
        "start": 53.93,
        "text": "磁盘I/O也不是内存迁移。"
      },
      {
        "start": 56.534,
        "text": "找到路径，才能定位瓶颈。"
      }
    ]
  },
  {
    "start": 65.4,
    "end": 99.5,
    "duration": 31.176,
    "file": "audio/quorum-migration-lesson/03.mp3",
    "captions": [
      {
        "start": 65.496,
        "text": "迁移前先检查配置锁、"
      },
      {
        "start": 67.765,
        "text": "资源条件和目标兼容性。"
      },
      {
        "start": 70.226,
        "text": "CPU、机器类型和软件版本，"
      },
      {
        "start": 72.796,
        "text": "都可能影响迁移。"
      },
      {
        "start": 74.335,
        "text": "本例排除不可迁移的直通资源。"
      },
      {
        "start": 77.113,
        "text": "检查通过，设置迁移锁。"
      },
      {
        "start": 79.706,
        "text": "目标启动接收进程。"
      },
      {
        "start": 81.916,
        "text": "进程已经存在，"
      },
      {
        "start": 83.294,
        "text": "但来宾指令尚未执行。"
      },
      {
        "start": 85.4,
        "text": "源端继续，目标只准备接收。"
      },
      {
        "start": 88.097,
        "text": "相同架构不代表所有配置兼容。"
      },
      {
        "start": 90.979,
        "text": "接收进程存在，只是准备条件。"
      },
      {
        "start": 94.0,
        "text": "目标的执行门仍然关闭。"
      }
    ]
  },
  {
    "start": 100.4,
    "end": 134.5,
    "duration": 30.096,
    "file": "audio/quorum-migration-lesson/04.mp3",
    "captions": [
      {
        "start": 100.496,
        "text": "开始第一轮内存预拷贝。"
      },
      {
        "start": 102.541,
        "text": "数据抵达，目标页才更新。"
      },
      {
        "start": 105.145,
        "text": "现在，源端再次写入P2。"
      },
      {
        "start": 107.912,
        "text": "它变成版本二，"
      },
      {
        "start": 109.208,
        "text": "目标仍然保留版本一。"
      },
      {
        "start": 111.361,
        "text": "P5也发生了变化。"
      },
      {
        "start": 113.305,
        "text": "脏页跟踪记住这些修改，"
      },
      {
        "start": 115.574,
        "text": "把它们列入待传集合。"
      },
      {
        "start": 117.634,
        "text": "这里的脏，是发生过写入，"
      },
      {
        "start": 119.787,
        "text": "不是内存损坏。"
      },
      {
        "start": 121.245,
        "text": "版本号只是教学标签。"
      },
      {
        "start": 123.467,
        "text": "看同一组页，两边内容不同。"
      },
      {
        "start": 126.349,
        "text": "只有新的数据抵达，"
      },
      {
        "start": 127.981,
        "text": "接收端才能追上这个变化。"
      }
    ]
  },
  {
    "start": 135.4,
    "end": 174.5,
    "duration": 32.184,
    "file": "audio/quorum-migration-lesson/05.mp3",
    "captions": [
      {
        "start": 135.496,
        "text": "下一轮重传已经变化的页。"
      },
      {
        "start": 137.958,
        "text": "目标暂时追上了。"
      },
      {
        "start": 139.625,
        "text": "源端又把P2改成版本三。"
      },
      {
        "start": 142.24,
        "text": "这就是预拷贝的竞争："
      },
      {
        "start": 143.872,
        "text": "一边传出，一边新增变化。"
      },
      {
        "start": 146.488,
        "text": "如果新增脏页太快，"
      },
      {
        "start": 148.039,
        "text": "剩余状态就难以缩小。"
      },
      {
        "start": 150.215,
        "text": "本路径启用了自动收敛，"
      },
      {
        "start": 152.217,
        "text": "管理层也可能调整允许停顿。"
      },
      {
        "start": 154.949,
        "text": "这些手段有性能或停顿代价。"
      },
      {
        "start": 157.796,
        "text": "热迁移不保证任何负载都无感。"
      },
      {
        "start": 160.701,
        "text": "收敛条是定性示意，"
      },
      {
        "start": 162.437,
        "text": "并非实测带宽曲线。"
      },
      {
        "start": 164.358,
        "text": "更快网络也要结合脏页速率看。"
      }
    ]
  },
  {
    "start": 175.4,
    "end": 214.5,
    "duration": 34.368,
    "file": "audio/quorum-migration-lesson/06.mp3",
    "captions": [
      {
        "start": 175.496,
        "text": "当剩余状态和切换条件合适，"
      },
      {
        "start": 178.193,
        "text": "进入最后的交接窗口。"
      },
      {
        "start": 180.458,
        "text": "先暂停源端来宾执行。"
      },
      {
        "start": 182.877,
        "text": "源端不再继续执行指令，"
      },
      {
        "start": 184.902,
        "text": "再完成剩余内存同步。"
      },
      {
        "start": 186.963,
        "text": "同时交接处理器和设备状态。"
      },
      {
        "start": 189.682,
        "text": "目标需要一致的运行状态，"
      },
      {
        "start": 191.719,
        "text": "不只是内存方块变绿。"
      },
      {
        "start": 193.664,
        "text": "画面把暂停窗口放大，"
      },
      {
        "start": 195.666,
        "text": "不代表真实停顿时长。"
      },
      {
        "start": 197.692,
        "text": "内存与设备分开显示，"
      },
      {
        "start": 199.671,
        "text": "也不规定内部序列化顺序。"
      },
      {
        "start": 201.939,
        "text": "具体停顿还受网络、"
      },
      {
        "start": 204.011,
        "text": "剩余状态和设备条件影响。"
      },
      {
        "start": 206.789,
        "text": "不能从视频秒数反推参数。"
      }
    ]
  },
  {
    "start": 215.4,
    "end": 249.5,
    "duration": 27.768,
    "file": "audio/quorum-migration-lesson/07.mp3",
    "captions": [
      {
        "start": 215.496,
        "text": "QEMU报告传输完成。"
      },
      {
        "start": 217.865,
        "text": "但PVE整个任务还没有结束。"
      },
      {
        "start": 220.632,
        "text": "在本例代码路径里，"
      },
      {
        "start": 222.275,
        "text": "配置的节点归属转到B。"
      },
      {
        "start": 224.324,
        "text": "随后发出恢复指令。"
      },
      {
        "start": 226.175,
        "text": "目标恢复执行。"
      },
      {
        "start": 227.9,
        "text": "这是管理状态和执行的交接，"
      },
      {
        "start": 230.168,
        "text": "不是再复制一遍内存，"
      },
      {
        "start": 231.754,
        "text": "也不是移动共享磁盘。"
      },
      {
        "start": 233.629,
        "text": "三个完成标志，要分开观察。"
      },
      {
        "start": 236.476,
        "text": "内存和设备的完成，"
      },
      {
        "start": 238.236,
        "text": "配置归属的完成，"
      },
      {
        "start": 239.775,
        "text": "以及目标执行的恢复，"
      },
      {
        "start": 241.303,
        "text": "并不是同一个状态。"
      }
    ]
  },
  {
    "start": 250.4,
    "end": 284.5,
    "duration": 30.432,
    "file": "audio/quorum-migration-lesson/08.mp3",
    "captions": [
      {
        "start": 250.496,
        "text": "目标接着原来的状态执行。"
      },
      {
        "start": 252.865,
        "text": "源QEMU进程随后清理。"
      },
      {
        "start": 255.481,
        "text": "所以，两边都有进程，"
      },
      {
        "start": 257.796,
        "text": "不等于两边的来宾同时执行。"
      },
      {
        "start": 260.354,
        "text": "源端在交接前已经暂停，"
      },
      {
        "start": 262.553,
        "text": "目标到现在才恢复。"
      },
      {
        "start": 264.358,
        "text": "共享NFS始终留在原位，"
      },
      {
        "start": 266.997,
        "text": "磁盘访问改由目标端发起。"
      },
      {
        "start": 269.462,
        "text": "这是执行的接续，"
      },
      {
        "start": 270.77,
        "text": "不是来宾操作系统重新启动。"
      },
      {
        "start": 273.317,
        "text": "旧进程保留和执行已经停止，"
      },
      {
        "start": 275.701,
        "text": "可以同时成立。"
      },
      {
        "start": 277.148,
        "text": "判断双实例风险，要看执行状态。"
      }
    ]
  },
  {
    "start": 285.4,
    "end": 324.5,
    "duration": 33.312,
    "file": "audio/quorum-migration-lesson/09.mp3",
    "captions": [
      {
        "start": 285.496,
        "text": "再看业务侧的连续性。"
      },
      {
        "start": 287.391,
        "text": "客户端请求要走到目标。"
      },
      {
        "start": 289.856,
        "text": "相同的来宾地址，"
      },
      {
        "start": 291.418,
        "text": "不保证宿主机防火墙，"
      },
      {
        "start": 293.236,
        "text": "或连接跟踪状态都已可用。"
      },
      {
        "start": 295.736,
        "text": "文档将连接跟踪迁移，"
      },
      {
        "start": 297.657,
        "text": "描述为尽力而为。"
      },
      {
        "start": 299.578,
        "text": "因此，分别检查迁移任务、"
      },
      {
        "start": 301.928,
        "text": "来宾运行和业务请求。"
      },
      {
        "start": 304.312,
        "text": "任务成功，来宾已经执行，"
      },
      {
        "start": 306.893,
        "text": "业务仍需独立探测。"
      },
      {
        "start": 309.231,
        "text": "探测成功，才确认本次请求。"
      },
      {
        "start": 312.032,
        "text": "一次请求成功，"
      },
      {
        "start": 313.421,
        "text": "也不是所有连接无损的证明。"
      },
      {
        "start": 315.759,
        "text": "验收标准应来自业务要求。"
      }
    ]
  },
  {
    "start": 325.4,
    "end": 364.5,
    "duration": 31.968,
    "file": "audio/quorum-migration-lesson/10.mp3",
    "captions": [
      {
        "start": 325.496,
        "text": "回看一个切换前的失败分支。"
      },
      {
        "start": 328.097,
        "text": "此时仍在预拷贝，"
      },
      {
        "start": 329.625,
        "text": "源端没有暂停。"
      },
      {
        "start": 331.233,
        "text": "现在，迁移传输失败。"
      },
      {
        "start": 333.56,
        "text": "源宿主机和控制路径仍正常。"
      },
      {
        "start": 336.638,
        "text": "管理流程取消并清理接收端。"
      },
      {
        "start": 339.405,
        "text": "目标从未开始执行，"
      },
      {
        "start": 341.094,
        "text": "源端可以继续运行。"
      },
      {
        "start": 343.097,
        "text": "这不代表任意失败都能回滚。"
      },
      {
        "start": 345.759,
        "text": "后续切换阶段或源端失联，"
      },
      {
        "start": 348.548,
        "text": "条件就不同了。"
      },
      {
        "start": 350.03,
        "text": "本集也没有启用后拷贝。"
      },
      {
        "start": 352.055,
        "text": "故障发生在哪个阶段，"
      },
      {
        "start": 353.814,
        "text": "以及还能控制哪一端，"
      },
      {
        "start": 355.226,
        "text": "共同决定后续处理。"
      }
    ]
  },
  {
    "start": 369.4,
    "end": 377,
    "duration": 5.448,
    "file": "audio/quorum-migration-lesson/11.mp3",
    "captions": [
      {
        "start": 369.496,
        "text": "判断一下："
      },
      {
        "start": 370.526,
        "text": "目标已经收到全部内存，"
      },
      {
        "start": 372.552,
        "text": "现在就能让来宾执行吗？"
      }
    ]
  },
  {
    "start": 381,
    "end": 394.5,
    "duration": 11.784,
    "file": "audio/quorum-migration-lesson/12.mp3",
    "captions": [
      {
        "start": 381.096,
        "text": "不能只看内存。"
      },
      {
        "start": 382.69,
        "text": "还需要最终运行状态，"
      },
      {
        "start": 384.461,
        "text": "以及相应的管理交接。"
      },
      {
        "start": 386.475,
        "text": "在本例中，先暂停源端，"
      },
      {
        "start": 388.882,
        "text": "完成同步与配置交接，"
      },
      {
        "start": 390.699,
        "text": "再恢复目标执行。"
      }
    ]
  },
  {
    "start": 395.4,
    "end": 419.5,
    "duration": 20.784,
    "file": "audio/quorum-migration-lesson/13.mp3",
    "captions": [
      {
        "start": 395.496,
        "text": "记住这条因果链。"
      },
      {
        "start": 397.206,
        "text": "运行中预拷贝，"
      },
      {
        "start": 398.71,
        "text": "跟踪并重传变化，"
      },
      {
        "start": 400.296,
        "text": "暂停并同步最终状态，"
      },
      {
        "start": 402.298,
        "text": "交接配置，再恢复目标。"
      },
      {
        "start": 404.81,
        "text": "共享磁盘可以留在原位。"
      },
      {
        "start": 407.136,
        "text": "下一集打开pmxcfs，"
      },
      {
        "start": 409.52,
        "text": "看配置如何在节点之间协作。"
      },
      {
        "start": 411.928,
        "text": "理解执行与配置的关系，"
      },
      {
        "start": 413.837,
        "text": "才能解释集群中的协作。"
      }
    ]
  }
]
