[
  {
    "start": 0.4,
    "end": 29.6,
    "duration": 22.536,
    "file": "audio/quorum-durability-lesson/01.mp3",
    "captions": [
      {
        "start": 0.496,
        "text": "虚拟机收到一次写入成功。"
      },
      {
        "start": 2.796,
        "text": "如果宿主此时突然断电，"
      },
      {
        "start": 4.949,
        "text": "数据一定还在吗？"
      },
      {
        "start": 6.534,
        "text": "先别急着回答。"
      },
      {
        "start": 8.189,
        "text": "成功由具体的一层报告，"
      },
      {
        "start": 10.157,
        "text": "不一定意味着越过所有缓存。"
      },
      {
        "start": 12.935,
        "text": "先看这份已经返回的完成。"
      },
      {
        "start": 15.296,
        "text": "新内容却还在宿主页缓存。"
      },
      {
        "start": 18.097,
        "text": "这集沿着数据和完成消息，"
      },
      {
        "start": 20.331,
        "text": "追问它们分别承诺什么。"
      }
    ]
  },
  {
    "start": 30.4,
    "end": 64.6,
    "duration": 26.352,
    "file": "audio/quorum-durability-lesson/02.mp3",
    "captions": [
      {
        "start": 30.496,
        "text": "先展开四层责任边界。"
      },
      {
        "start": 32.796,
        "text": "左边是来宾的块设备请求。"
      },
      {
        "start": 35.169,
        "text": "接着是虚拟设备的模拟。"
      },
      {
        "start": 37.182,
        "text": "块后端再把它交给文件后端。"
      },
      {
        "start": 39.798,
        "text": "本例写入一份本地文件。"
      },
      {
        "start": 42.171,
        "text": "宿主内核管理文件和页缓存。"
      },
      {
        "start": 45.122,
        "text": "设备内部还有自己的写缓存。"
      },
      {
        "start": 47.784,
        "text": "最下方才是非易失存储。"
      },
      {
        "start": 49.949,
        "text": "两处易失缓存不是一个位置。"
      },
      {
        "start": 52.668,
        "text": "先认清组件，"
      },
      {
        "start": 53.988,
        "text": "接下来始终沿同一条路径观察。"
      }
    ]
  },
  {
    "start": 65.4,
    "end": 99.6,
    "duration": 27.384,
    "file": "audio/quorum-durability-lesson/03.mp3",
    "captions": [
      {
        "start": 65.496,
        "text": "先固定一个可核查的案例。"
      },
      {
        "start": 67.865,
        "text": "虚拟写缓存显式开启。"
      },
      {
        "start": 70.064,
        "text": "宿主使用回写模式。"
      },
      {
        "start": 72.159,
        "text": "后端是本地原始格式文件。"
      },
      {
        "start": 74.694,
        "text": "文件操作选择线程式路径。"
      },
      {
        "start": 77.553,
        "text": "管理配置决定这些参数，"
      },
      {
        "start": 79.486,
        "text": "随后由虚拟机进程执行请求。"
      },
      {
        "start": 82.287,
        "text": "并非每次写入都经过管理服务。"
      },
      {
        "start": 85.319,
        "text": "这些是教学选择，"
      },
      {
        "start": 86.882,
        "text": "不是平台的默认配置说明。"
      },
      {
        "start": 88.942,
        "text": "更换后端时，"
      },
      {
        "start": 90.203,
        "text": "需要重新核查下层实现。"
      }
    ]
  },
  {
    "start": 100.4,
    "end": 144.6,
    "duration": 35.808,
    "file": "audio/quorum-durability-lesson/04.mp3",
    "captions": [
      {
        "start": 100.496,
        "text": "现在从一个块设备写请求开始。"
      },
      {
        "start": 103.34,
        "text": "来宾提交第一次写入。"
      },
      {
        "start": 105.342,
        "text": "虚拟设备接收请求，"
      },
      {
        "start": 107.194,
        "text": "块后端执行文件写入。"
      },
      {
        "start": 109.3,
        "text": "数据进入宿主页缓存。"
      },
      {
        "start": 111.789,
        "text": "回写模式允许先报告写完成。"
      },
      {
        "start": 114.902,
        "text": "结果经过块后端和虚拟设备，"
      },
      {
        "start": 117.507,
        "text": "最终返回来宾。"
      },
      {
        "start": 119.046,
        "text": "看左边，写完成已经收到。"
      },
      {
        "start": 121.708,
        "text": "看右边，新内容还没有持久保存。"
      },
      {
        "start": 125.157,
        "text": "我们选择后台回写未完成的窗口。"
      },
      {
        "start": 127.981,
        "text": "实际也可能更早写出。"
      },
      {
        "start": 130.088,
        "text": "这个例子说明，"
      },
      {
        "start": 131.233,
        "text": "写请求完成不能独立证明，"
      },
      {
        "start": 133.467,
        "text": "数据已经获得抗断电保证。"
      }
    ]
  },
  {
    "start": 145.4,
    "end": 179.6,
    "duration": 26.952,
    "file": "audio/quorum-durability-lesson/05.mp3",
    "captions": [
      {
        "start": 145.496,
        "text": "把时间停在刚才的窗口。"
      },
      {
        "start": 147.668,
        "text": "只改变一个变量。"
      },
      {
        "start": 149.347,
        "text": "现在模拟失去供电。"
      },
      {
        "start": 151.118,
        "text": "易失缓存的内容不能再依赖。"
      },
      {
        "start": 153.618,
        "text": "左边保留已经收到的写完成。"
      },
      {
        "start": 156.303,
        "text": "它是历史结果，"
      },
      {
        "start": 157.692,
        "text": "不能把内存变成非易失存储。"
      },
      {
        "start": 160.377,
        "text": "新内容可能丢失或者不完整。"
      },
      {
        "start": 163.004,
        "text": "不要画成必然完整退回旧值。"
      },
      {
        "start": 165.747,
        "text": "这里没有证明写入原子性。"
      },
      {
        "start": 168.247,
        "text": "这只是机制推演，"
      },
      {
        "start": 169.787,
        "text": "还没有进行真实断电实验。"
      }
    ]
  },
  {
    "start": 180.4,
    "end": 229.6,
    "duration": 41.952,
    "file": "audio/quorum-durability-lesson/06.mp3",
    "captions": [
      {
        "start": 180.496,
        "text": "回到独立的正常供电路径。"
      },
      {
        "start": 183.004,
        "text": "仍然观察刚才那次已完成的写。"
      },
      {
        "start": 185.724,
        "text": "来宾现在提交刷新请求。"
      },
      {
        "start": 188.132,
        "text": "刷新不携带第二份新数据。"
      },
      {
        "start": 190.562,
        "text": "它要求下层兑现持久化条件。"
      },
      {
        "start": 193.386,
        "text": "虚拟设备转交块后端。"
      },
      {
        "start": 195.782,
        "text": "文件后端开始同步调用。"
      },
      {
        "start": 198.305,
        "text": "注意分开看两种颜色。"
      },
      {
        "start": 200.377,
        "text": "蓝色脏数据先向下写出。"
      },
      {
        "start": 202.981,
        "text": "数据先到设备的易失缓存。"
      },
      {
        "start": 205.828,
        "text": "设备随后兑现相关刷新。"
      },
      {
        "start": 208.398,
        "text": "新内容才到非易失存储。"
      },
      {
        "start": 210.932,
        "text": "不能只刷新设备，"
      },
      {
        "start": 212.344,
        "text": "却把相关脏数据留在宿主内存。"
      },
      {
        "start": 215.435,
        "text": "具体文件系统可以使用不同命令。"
      },
      {
        "start": 218.259,
        "text": "这里画的是语义关系，"
      },
      {
        "start": 219.925,
        "text": "不是实测的物理命令序列。"
      }
    ]
  },
  {
    "start": 230.4,
    "end": 264.6,
    "duration": 30.624,
    "file": "audio/quorum-durability-lesson/07.mp3",
    "captions": [
      {
        "start": 230.496,
        "text": "现在，下层持久化已经完成。"
      },
      {
        "start": 233.49,
        "text": "完成结果开始向上返回。"
      },
      {
        "start": 236.21,
        "text": "宿主的同步调用先完成。"
      },
      {
        "start": 238.745,
        "text": "再返回文件和块后端。"
      },
      {
        "start": 241.106,
        "text": "接着通知虚拟设备。"
      },
      {
        "start": 243.05,
        "text": "最后来宾才收到刷新完成。"
      },
      {
        "start": 245.701,
        "text": "下层已经完成时，"
      },
      {
        "start": 247.263,
        "text": "上层仍可能等待回程消息。"
      },
      {
        "start": 249.752,
        "text": "缓存里可以继续保留副本。"
      },
      {
        "start": 252.206,
        "text": "这不表示它仍然是脏数据。"
      },
      {
        "start": 254.937,
        "text": "正常回程依赖下层兑现语义。"
      },
      {
        "start": 257.761,
        "text": "出现错误就不能照常宣告成功。"
      }
    ]
  },
  {
    "start": 265.4,
    "end": 304.6,
    "duration": 34.632,
    "file": "audio/quorum-durability-lesson/08.mp3",
    "captions": [
      {
        "start": 265.496,
        "text": "现在比较三种缓存模式。"
      },
      {
        "start": 267.888,
        "text": "先拆开三个独立的问题。"
      },
      {
        "start": 270.157,
        "text": "虚拟设备是否报告写缓存？"
      },
      {
        "start": 273.097,
        "text": "宿主是否绕过页缓存？"
      },
      {
        "start": 275.331,
        "text": "刷新请求是否被忽略？"
      },
      {
        "start": 277.842,
        "text": "回写模式使用宿主页缓存，"
      },
      {
        "start": 280.4,
        "text": "并且保留刷新语义。"
      },
      {
        "start": 282.229,
        "text": "再看绕过宿主页缓存的模式。"
      },
      {
        "start": 284.74,
        "text": "这并不关闭设备自己的缓存。"
      },
      {
        "start": 287.298,
        "text": "刷新仍然有意义。"
      },
      {
        "start": 289.057,
        "text": "最后是允许忽略刷新的模式。"
      },
      {
        "start": 291.962,
        "text": "不能把刷新完成当成持久化证据。"
      },
      {
        "start": 295.203,
        "text": "不要根据一个模式名称，"
      },
      {
        "start": 297.043,
        "text": "推断整个存储栈都没有缓存。"
      }
    ]
  },
  {
    "start": 305.4,
    "end": 339.6,
    "duration": 25.008,
    "file": "audio/quorum-durability-lesson/09.mp3",
    "captions": [
      {
        "start": 305.496,
        "text": "再区分两种块层语义。"
      },
      {
        "start": 307.53,
        "text": "预刷新关注此前已完成的写。"
      },
      {
        "start": 310.145,
        "text": "看前面两次写入，"
      },
      {
        "start": 311.662,
        "text": "它们要先到非易失存储。"
      },
      {
        "start": 313.687,
        "text": "再看强制单次写入持久化。"
      },
      {
        "start": 316.442,
        "text": "本次写入自身到达非易失存储，"
      },
      {
        "start": 319.0,
        "text": "才允许报告这次请求完成。"
      },
      {
        "start": 321.523,
        "text": "底层可以转换为不同操作。"
      },
      {
        "start": 323.872,
        "text": "这是内核块层的语义比较。"
      },
      {
        "start": 326.037,
        "text": "不表示本例虚拟设备，"
      },
      {
        "start": 327.784,
        "text": "直接发送了同名硬件命令。"
      }
    ]
  },
  {
    "start": 340.4,
    "end": 379.6,
    "duration": 33.816,
    "file": "audio/quorum-durability-lesson/10.mp3",
    "captions": [
      {
        "start": 340.496,
        "text": "现在把视角向应用延伸。"
      },
      {
        "start": 343.143,
        "text": "应用写入和块请求不是一回事。"
      },
      {
        "start": 346.118,
        "text": "我们还没有证明业务事务提交。"
      },
      {
        "start": 348.837,
        "text": "需要继续核查应用的同步时机。"
      },
      {
        "start": 351.523,
        "text": "还要追踪文件系统和日志协议。"
      },
      {
        "start": 354.312,
        "text": "再看失败如何反馈和处理。"
      },
      {
        "start": 356.766,
        "text": "下层持久化是一个重要条件，"
      },
      {
        "start": 359.37,
        "text": "却不自动提供整笔事务原子性。"
      },
      {
        "start": 362.032,
        "text": "也不能替代副本和备份。"
      },
      {
        "start": 364.254,
        "text": "架构评审应分别列出这些保证。"
      },
      {
        "start": 366.974,
        "text": "哪一层给出承诺，"
      },
      {
        "start": 368.444,
        "text": "就到那一层核查证据。"
      },
      {
        "start": 370.412,
        "text": "不要让一个成功提示，"
      },
      {
        "start": 371.997,
        "text": "替代整条路径的分析。"
      }
    ]
  },
  {
    "start": 380.4,
    "end": 419.6,
    "duration": 36.912,
    "file": "audio/quorum-durability-lesson/11.mp3",
    "captions": [
      {
        "start": 380.496,
        "text": "最后用三个问题检查理解。"
      },
      {
        "start": 383.027,
        "text": "收到写完成，是否已经持久保存？"
      },
      {
        "start": 386.418,
        "text": "答案是不能仅凭它保证。"
      },
      {
        "start": 388.618,
        "text": "介质完成后，来宾立即知道吗？"
      },
      {
        "start": 391.569,
        "text": "还需要等待结果向上返回。"
      },
      {
        "start": 393.976,
        "text": "绕过宿主页缓存，"
      },
      {
        "start": 395.724,
        "text": "是否就关闭了设备缓存？"
      },
      {
        "start": 397.946,
        "text": "答案也是否定的。"
      },
      {
        "start": 399.567,
        "text": "现在回放正常路径。"
      },
      {
        "start": 401.604,
        "text": "数据先进入缓存，写完成返回。"
      },
      {
        "start": 404.972,
        "text": "来宾提交刷新，数据继续向下。"
      },
      {
        "start": 408.212,
        "text": "下层持久化后，刷新完成返回。"
      },
      {
        "start": 411.337,
        "text": "以后遇到任何写入成功，"
      },
      {
        "start": 413.074,
        "text": "都追问由谁报告，"
      },
      {
        "start": 414.486,
        "text": "数据在哪里，还有哪些前提。"
      }
    ]
  }
]
