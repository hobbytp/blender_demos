[
  {
    "start": 0.3,
    "end": 29.9,
    "duration": 29.16,
    "file": "audio/quorum-virtqueue-lesson/01.mp3",
    "captions": [
      {
        "start": 0.396,
        "text": "缓冲区已经回收了。"
      },
      {
        "start": 2.406,
        "text": "远端就收到网络包了吗？"
      },
      {
        "start": 4.386,
        "text": "先看左边，驱动确实完成回收。"
      },
      {
        "start": 7.499,
        "text": "再看右边，远端状态仍然未知。"
      },
      {
        "start": 10.775,
        "text": "这两个结果并不矛盾。"
      },
      {
        "start": 12.684,
        "text": "本集跟踪一次虚拟网卡发送，"
      },
      {
        "start": 14.907,
        "text": "从描述符发布到后端取用，"
      },
      {
        "start": 17.187,
        "text": "再到完成记录和缓冲区回收。"
      },
      {
        "start": 19.825,
        "text": "关键是分清三个东西。"
      },
      {
        "start": 21.897,
        "text": "通知负责提醒，"
      },
      {
        "start": 23.228,
        "text": "队列记录负责交接，"
      },
      {
        "start": 24.71,
        "text": "数据留在被引用的缓冲区里。"
      },
      {
        "start": 27.187,
        "text": "让我们从这份内存开始。"
      }
    ]
  },
  {
    "start": 30.3,
    "end": 69.9,
    "duration": 35.736,
    "file": "audio/quorum-virtqueue-lesson/02.mp3",
    "captions": [
      {
        "start": 30.396,
        "text": "先把责任边界展开。"
      },
      {
        "start": 32.453,
        "text": "左边是来宾的虚拟网卡驱动。"
      },
      {
        "start": 35.069,
        "text": "中间放大的是来宾内存，"
      },
      {
        "start": 37.163,
        "text": "并不是新建了一份宿主队列。"
      },
      {
        "start": 39.432,
        "text": "右边上方是用户态的模拟器。"
      },
      {
        "start": 42.094,
        "text": "它负责设备和后端的配置，"
      },
      {
        "start": 44.096,
        "text": "把内存映射、队列地址，"
      },
      {
        "start": 46.18,
        "text": "以及通知通道交给后端。"
      },
      {
        "start": 48.564,
        "text": "右边下方是内核后端。"
      },
      {
        "start": 50.821,
        "text": "本例由它处理发送数据，"
      },
      {
        "start": 52.8,
        "text": "再提交给宿主虚拟网口。"
      },
      {
        "start": 55.15,
        "text": "虚拟化内核负责来宾执行，"
      },
      {
        "start": 57.58,
        "text": "并参与虚拟设备通知支持。"
      },
      {
        "start": 60.184,
        "text": "但它不是画面里的网络包中转站。"
      },
      {
        "start": 62.904,
        "text": "这是一条明确选定的教学路径。"
      }
    ]
  },
  {
    "start": 70.3,
    "end": 114.9,
    "duration": 38.784,
    "file": "audio/quorum-virtqueue-lesson/03.mp3",
    "captions": [
      {
        "start": 70.396,
        "text": "现在展开描述符的内部。"
      },
      {
        "start": 72.661,
        "text": "数据包已经准备在来宾内存。"
      },
      {
        "start": 75.312,
        "text": "驱动填写两项描述符。"
      },
      {
        "start": 77.615,
        "text": "第一项指向虚拟网卡头部。"
      },
      {
        "start": 79.941,
        "text": "第二项指向网络包数据。"
      },
      {
        "start": 82.337,
        "text": "地址字段告诉后端到哪里访问。"
      },
      {
        "start": 85.092,
        "text": "长度字段说明这段有多少字节。"
      },
      {
        "start": 88.205,
        "text": "标志字段描述方向和链关系。"
      },
      {
        "start": 91.018,
        "text": "本例发送缓冲由设备读取，"
      },
      {
        "start": 93.506,
        "text": "不是让设备向里面写入。"
      },
      {
        "start": 95.45,
        "text": "第一项带有下一项标志，"
      },
      {
        "start": 97.071,
        "text": "下一项索引指向第二项。"
      },
      {
        "start": 99.224,
        "text": "所以链头就能找到整份请求。"
      },
      {
        "start": 102.187,
        "text": "地址引用也不是数据复制。"
      },
      {
        "start": 104.768,
        "text": "接下来要解决的，"
      },
      {
        "start": 106.18,
        "text": "是后端什么时候能看到这条链。"
      }
    ]
  },
  {
    "start": 115.3,
    "end": 159.9,
    "duration": 39.6,
    "file": "audio/quorum-virtqueue-lesson/04.mp3",
    "captions": [
      {
        "start": 115.396,
        "text": "驱动先填写可用环槽位。"
      },
      {
        "start": 117.95,
        "text": "槽位里面放的是链头编号。"
      },
      {
        "start": 120.543,
        "text": "这时索引仍然保持旧值。"
      },
      {
        "start": 123.159,
        "text": "接着执行发布前的内存屏障。"
      },
      {
        "start": 125.647,
        "text": "确保描述符和槽位的写入，"
      },
      {
        "start": 127.927,
        "text": "先于新索引对后端可见。"
      },
      {
        "start": 130.358,
        "text": "然后发布可用环索引。"
      },
      {
        "start": 132.545,
        "text": "现在后端已经可以访问请求。"
      },
      {
        "start": 135.138,
        "text": "通知并不是访问权限的开关。"
      },
      {
        "start": 137.684,
        "text": "如果后端正在主动检查，"
      },
      {
        "start": 140.069,
        "text": "它可以在通知之前发现变化。"
      },
      {
        "start": 142.372,
        "text": "本例选择后端等待通知，"
      },
      {
        "start": 144.305,
        "text": "驱动检查通知抑制条件，"
      },
      {
        "start": 146.284,
        "text": "需要时才敲响队列门铃。"
      },
      {
        "start": 148.772,
        "text": "所以顺序是内容、屏障、索引，"
      },
      {
        "start": 152.001,
        "text": "最后才判断是否需要提醒。"
      }
    ]
  },
  {
    "start": 160.3,
    "end": 204.9,
    "duration": 37.296,
    "file": "audio/quorum-virtqueue-lesson/05.mp3",
    "captions": [
      {
        "start": 160.396,
        "text": "现在发出队列通知。"
      },
      {
        "start": 162.383,
        "text": "门铃只提醒后端检查队列，"
      },
      {
        "start": 164.536,
        "text": "不把整个数据包装进通知。"
      },
      {
        "start": 166.897,
        "text": "后端读取可用环索引。"
      },
      {
        "start": 169.293,
        "text": "发现有新的链头可以处理。"
      },
      {
        "start": 171.492,
        "text": "后端取得描述符链。"
      },
      {
        "start": 173.437,
        "text": "按地址映射访问发送缓冲区。"
      },
      {
        "start": 176.469,
        "text": "本例选择内核的复制发送分支，"
      },
      {
        "start": 178.761,
        "text": "不走零拷贝和批量卸载分支。"
      },
      {
        "start": 181.527,
        "text": "随后向虚拟网口提交数据。"
      },
      {
        "start": 184.05,
        "text": "本次提交成功。"
      },
      {
        "start": 185.867,
        "text": "这说明宿主侧接收了本次提交，"
      },
      {
        "start": 188.83,
        "text": "还不能推断物理网卡已经发出。"
      },
      {
        "start": 191.446,
        "text": "后端接下来要归还缓冲区，"
      },
      {
        "start": 193.61,
        "text": "它需要写完成记录，"
      },
      {
        "start": 195.126,
        "text": "而不是先发一个成功中断。"
      }
    ]
  },
  {
    "start": 205.3,
    "end": 249.9,
    "duration": 41.496,
    "file": "audio/quorum-virtqueue-lesson/06.mp3",
    "captions": [
      {
        "start": 205.396,
        "text": "后端先填写已用环槽位。"
      },
      {
        "start": 207.962,
        "text": "记录里标识完成的链头。"
      },
      {
        "start": 210.126,
        "text": "本例发送的已用长度为零，"
      },
      {
        "start": 212.314,
        "text": "表示没有写回来宾缓冲区，"
      },
      {
        "start": 214.166,
        "text": "不是发送了零字节。"
      },
      {
        "start": 215.902,
        "text": "经过发布所需的内存屏障，"
      },
      {
        "start": 218.066,
        "text": "后端再发布已用环索引。"
      },
      {
        "start": 220.346,
        "text": "随后才发送完成通知。"
      },
      {
        "start": 222.765,
        "text": "通知只提醒驱动检查队列。"
      },
      {
        "start": 225.474,
        "text": "驱动读取已用环结果。"
      },
      {
        "start": 227.904,
        "text": "读取索引和条目也有顺序要求。"
      },
      {
        "start": 230.694,
        "text": "驱动根据链头找到原请求，"
      },
      {
        "start": 233.055,
        "text": "再解除描述符链的占用。"
      },
      {
        "start": 235.08,
        "text": "现在可以回收发送缓冲区。"
      },
      {
        "start": 237.534,
        "text": "观察两个环的索引，"
      },
      {
        "start": 239.108,
        "text": "回收以后它们并不归零。"
      },
      {
        "start": 241.446,
        "text": "索引描述队列的推进位置，"
      },
      {
        "start": 243.633,
        "text": "空闲描述符由驱动另行管理。"
      }
    ]
  },
  {
    "start": 250.3,
    "end": 289.9,
    "duration": 37.8,
    "file": "audio/quorum-virtqueue-lesson/07.mp3",
    "captions": [
      {
        "start": 250.396,
        "text": "换一个独立的通知对照。"
      },
      {
        "start": 252.557,
        "text": "新请求已发布并完成提交，"
      },
      {
        "start": 254.895,
        "text": "驱动暂时抑制完成通知。"
      },
      {
        "start": 257.175,
        "text": "后端仍然发布完成记录。"
      },
      {
        "start": 259.444,
        "text": "驱动主动检查已用环。"
      },
      {
        "start": 261.99,
        "text": "于是仍能回收缓冲区。"
      },
      {
        "start": 264.281,
        "text": "没有中断不等于没有完成。"
      },
      {
        "start": 266.944,
        "text": "再单独看通知恢复的竞态。"
      },
      {
        "start": 269.409,
        "text": "驱动刚检查时没有新结果。"
      },
      {
        "start": 272.059,
        "text": "后端此时发布了一个完成。"
      },
      {
        "start": 274.339,
        "text": "驱动重新开启完成通知。"
      },
      {
        "start": 276.735,
        "text": "随后必须再检查队列。"
      },
      {
        "start": 278.703,
        "text": "发现新结果就继续处理，"
      },
      {
        "start": 280.613,
        "text": "不能直接睡下等待下一次提醒。"
      },
      {
        "start": 283.194,
        "text": "这是通用队列接口的示意，"
      },
      {
        "start": 285.138,
        "text": "不是所有网卡驱动的固定调度。"
      }
    ]
  },
  {
    "start": 290.3,
    "end": 334.9,
    "duration": 38.688,
    "file": "audio/quorum-virtqueue-lesson/08.mp3",
    "captions": [
      {
        "start": 290.396,
        "text": "把视角拉回宿主边界。"
      },
      {
        "start": 292.58,
        "text": "内核后端优化了哪一段？"
      },
      {
        "start": 294.918,
        "text": "队列取用和数据提交，"
      },
      {
        "start": 296.596,
        "text": "在本例由宿主内核执行。"
      },
      {
        "start": 298.9,
        "text": "不需要用户态模拟器，"
      },
      {
        "start": 300.659,
        "text": "逐包解释这条发送请求。"
      },
      {
        "start": 303.205,
        "text": "但用户态模拟器并没有消失。"
      },
      {
        "start": 305.879,
        "text": "设备建立、特性协商和配置，"
      },
      {
        "start": 308.61,
        "text": "以及后端与通知通道的连接，"
      },
      {
        "start": 310.647,
        "text": "仍有控制面的工作。"
      },
      {
        "start": 312.453,
        "text": "同样，使用内核后端，"
      },
      {
        "start": 314.571,
        "text": "也不自动意味着零拷贝。"
      },
      {
        "start": 316.538,
        "text": "更不保证消除所有虚拟机退出。"
      },
      {
        "start": 319.49,
        "text": "本集没有性能实测，"
      },
      {
        "start": 321.18,
        "text": "因此不附加吞吐提升倍数。"
      },
      {
        "start": 323.714,
        "text": "判断优化要看实际选中的路径，"
      },
      {
        "start": 326.295,
        "text": "再结合负载和测量结果。"
      }
    ]
  },
  {
    "start": 335.3,
    "end": 374.9,
    "duration": 36.432,
    "file": "audio/quorum-virtqueue-lesson/09.mp3",
    "captions": [
      {
        "start": 335.396,
        "text": "现在按照证据层级复盘。"
      },
      {
        "start": 337.788,
        "text": "第一层，驱动已经读到完成，"
      },
      {
        "start": 340.323,
        "text": "可以回收这次发送缓冲。"
      },
      {
        "start": 342.372,
        "text": "第二层，在选定的成功分支，"
      },
      {
        "start": 344.663,
        "text": "宿主虚拟网口接收了提交。"
      },
      {
        "start": 347.175,
        "text": "第三层，远端传输协议确认，"
      },
      {
        "start": 349.721,
        "text": "需要独立的网络协议证据。"
      },
      {
        "start": 352.059,
        "text": "第四层，远端应用处理成功，"
      },
      {
        "start": 354.606,
        "text": "还需要应用自己的响应。"
      },
      {
        "start": 356.423,
        "text": "这四层不能互相替代。"
      },
      {
        "start": 358.506,
        "text": "尤其不能把已用环条目，"
      },
      {
        "start": 360.335,
        "text": "当作远端应用的成功回执。"
      },
      {
        "start": 362.869,
        "text": "我们排除了本例的错误路径，"
      },
      {
        "start": 364.883,
        "text": "才能讨论这一条成功提交。"
      },
      {
        "start": 367.268,
        "text": "先问卡在哪一个边界，"
      },
      {
        "start": 368.842,
        "text": "再沿着该层的队列和状态取证。"
      }
    ]
  },
  {
    "start": 375.3,
    "end": 419.9,
    "duration": 41.76,
    "file": "audio/quorum-virtqueue-lesson/10.mp3",
    "captions": [
      {
        "start": 375.396,
        "text": "通知里携带整个数据包吗？"
      },
      {
        "start": 377.893,
        "text": "不携带，它只是提醒检查。"
      },
      {
        "start": 380.474,
        "text": "看到已用索引就能直接回收吗？"
      },
      {
        "start": 383.194,
        "text": "还要读取条目并找到原请求。"
      },
      {
        "start": 386.075,
        "text": "缓冲回收证明远端应用成功吗？"
      },
      {
        "start": 389.258,
        "text": "不能，那个证据在更高层。"
      },
      {
        "start": 391.7,
        "text": "现在回放一次正常发送。"
      },
      {
        "start": 393.795,
        "text": "描述符引用准备好的数据。"
      },
      {
        "start": 396.18,
        "text": "链头写入可用环。"
      },
      {
        "start": 398.031,
        "text": "经过屏障，发布索引。"
      },
      {
        "start": 400.346,
        "text": "通知后端，再取用描述符。"
      },
      {
        "start": 402.893,
        "text": "按地址访问并提交数据。"
      },
      {
        "start": 405.381,
        "text": "后端写入并发布已用记录。"
      },
      {
        "start": 408.008,
        "text": "提醒驱动，读取完成结果。"
      },
      {
        "start": 410.74,
        "text": "最后回收描述符和缓冲区。"
      },
      {
        "start": 413.645,
        "text": "远端是否收到，仍需独立证明。"
      }
    ]
  }
]
